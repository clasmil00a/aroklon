<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme: alternate for bright rooms and the discount dialog reference. -->

    <Color x:Key="Color.Bg">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface">#FFF4F6F8</Color>
    <Color x:Key="Color.SurfaceRaised">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceHover">#FFEEF1F4</Color>
    <Color x:Key="Color.Border">#FFD5D9DE</Color>
    <Color x:Key="Color.BorderInput">#FF737D87</Color>
    <Color x:Key="Color.Text">#FF1F2328</Color>
    <Color x:Key="Color.TextMuted">#FF5B6570</Color>
    <Color x:Key="Color.TextDisabled">#FF8A8F96</Color>
    <Color x:Key="Color.Accent">#FF0D6F9F</Color>
    <Color x:Key="Color.AccentHover">#FF095A82</Color>
    <Color x:Key="Color.AccentActive">#FF064A6B</Color>
    <Color x:Key="Color.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="Color.OnAccentMuted">#FFE8F3F8</Color>
    <Color x:Key="Color.Danger">#FFB3261E</Color>
    <Color x:Key="Color.DangerSolid">#FFB3261E</Color>
    <Color x:Key="Color.DangerSolidHover">#FF8F1D17</Color>
    <Color x:Key="Color.OnDanger">#FFFFFFFF</Color>
    <Color x:Key="Color.Success">#FF1F6B3A</Color>
    <Color x:Key="Color.SuccessSolid">#FF1F6B3A</Color>
    <Color x:Key="Color.SuccessSolidHover">#FF17532D</Color>
    <Color x:Key="Color.OnSuccess">#FFFFFFFF</Color>
    <Color x:Key="Color.Warning">#FF7A4F00</Color>
    <Color x:Key="Color.WarningSolid">#FF7A4F00</Color>
    <Color x:Key="Color.WarningSolidHover">#FF5F3D00</Color>
    <Color x:Key="Color.OnWarning">#FFFFFFFF</Color>
    <Color x:Key="Color.Focus">#FF0D6F9F</Color>
    <Color x:Key="Color.Scrim">#FF000000</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderInput" Color="{StaticResource Color.BorderInput}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentActive" Color="{StaticResource Color.AccentActive}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.OnAccentMuted" Color="{StaticResource Color.OnAccentMuted}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSolid" Color="{StaticResource Color.DangerSolid}" />
    <SolidColorBrush x:Key="Brush.DangerSolidHover" Color="{StaticResource Color.DangerSolidHover}" />
    <SolidColorBrush x:Key="Brush.OnDanger" Color="{StaticResource Color.OnDanger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSolid" Color="{StaticResource Color.SuccessSolid}" />
    <SolidColorBrush x:Key="Brush.SuccessSolidHover" Color="{StaticResource Color.SuccessSolidHover}" />
    <SolidColorBrush x:Key="Brush.OnSuccess" Color="{StaticResource Color.OnSuccess}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSolid" Color="{StaticResource Color.WarningSolid}" />
    <SolidColorBrush x:Key="Brush.WarningSolidHover" Color="{StaticResource Color.WarningSolidHover}" />
    <SolidColorBrush x:Key="Brush.OnWarning" Color="{StaticResource Color.OnWarning}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#73000000" />

    <DropShadowEffect x:Key="Effect.Pop" Color="#FF17202C" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.14" />
    <DropShadowEffect x:Key="Effect.Dialog" Color="#FF17202C" BlurRadius="64" ShadowDepth="24" Direction="270" Opacity="0.22" />

</ResourceDictionary>
