<Application
    x:Class="Pos.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Pos.App.ViewModels"
    xmlns:conv="clr-namespace:Pos.App.Converters"
    xmlns:views="clr-namespace:Pos.App.Views"
    ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Dark.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
                <views:OnboardingView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ShellViewModel}">
                <views:ShellView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ManagementViewModel}">
                <views:ManagementView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProductGroupViewModel}">
                <views:ProductGroupView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CustomerSelectionViewModel}">
                <views:CustomerSelectionView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PaymentTypeViewModel}">
                <views:PaymentTypeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
                <views:UserManagementView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PosViewModel}">
                <views:PosView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UnitViewModel}">
                <views:UnitView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProductListViewModel}">
                <views:ProductListView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProductEditorViewModel}">
                <views:ProductEditorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PriceListViewModel}">
                <views:PriceListView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PriceListEditorViewModel}">
                <views:PriceListEditorView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProductPriceViewModel}">
                <views:ProductPriceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
                <views:DatabaseView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PaymentTypeViewModel}">
                <views:PaymentTypeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OpenOrdersViewModel}">
                <views:OpenOrdersView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReceiptViewModel}">
                <views:ReceiptView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
                <views:SalesHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CashMovementViewModel}">
                <views:CashMovementView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RefundViewModel}">
                <views:RefundView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EndOfDayViewModel}">
                <views:EndOfDayView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:VisualWorkspaceViewModel}">
                <views:VisualWorkspaceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ScreenStubViewModel}">
                <views:StubView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
