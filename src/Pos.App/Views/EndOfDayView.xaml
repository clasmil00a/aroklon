<UserControl
    x:Class="Pos.App.Views.EndOfDayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}"
    Loaded="OnLoaded">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        CanContentScroll="False"
        PanningMode="VerticalOnly">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Tutup Hari" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="Tutup register, cetak laporan Z, dan hitung selisih kas." />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Badge}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="S35 · M4" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Day status -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Status hari bisnis" />
                    <TextBlock
                        Style="{StaticResource Text.BodyStrong}"
                        Text="{Binding BusinessDate, TargetNullValue='—'}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding DayOpen, Converter={StaticResource BoolToText}, ConverterParameter='Terbuka|Tertutup'}" />

                    <Border Margin="0,16,0,0" Padding="10" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderInput}" BorderThickness="{StaticResource Border.Width}" CornerRadius="{StaticResource Radius.Sm}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.SectionTitle}" Text="Ringkasan hari" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Jualan" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Refund" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Grand total" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Kas masuk" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Kas keluar" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SalesCount}" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding RefundCount}" />
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding GrandTotal, StringFormat='Rp {0:N0}'}" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CashIn, StringFormat='Rp {0:N0}'}" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CashOut, StringFormat='Rp {0:N0}'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button
                        Margin="0,16,0,0"
                        Height="44"
                        Command="{Binding PrintXReportCommand}"
                        Content="Cetak Laporan X (Belum Tutup)"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Secondary}" />

                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding GoBackCommand}"
                        Content="← Kembali ke beranda"
                        Style="{StaticResource Button.Ghost}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Close day -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card.Raised}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Tutup register" />
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.Caption}"
                        Text="Masukkan jumlah kas aktual di laci dan tutup hari bisnis." />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Kas aktual di laci" />
                    <TextBox
                        Style="{StaticResource Input}"
                        Text="{Binding ClosingCash, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,6" Style="{StaticResource Text.Caption}" Text="Diharapkan di laci" />
                    <TextBlock
                        Style="{StaticResource Text.BodyStrong}"
                        Text="{Binding ExpectedCash}" />

                    <TextBlock Margin="0,10,0,6" Style="{StaticResource Text.Caption}" Text="Catatan selisih (opsional)" />
                    <TextBox
                        Style="{StaticResource Input}"
                        Text="{Binding VarianceNote, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Margin="0,16,0,0"
                        Height="44"
                        Command="{Binding CloseDayCommand}"
                        Content="Tutup Hari &amp; Cetak Z"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Primary}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding InfoMessage}"
                        Visibility="{Binding InfoMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- X report preview -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card.Raised}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Pratinjau Laporan X" />
                    <Border Padding="12" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderInput}" BorderThickness="{StaticResource Border.Width}" CornerRadius="{StaticResource Radius.Sm}">
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.Sm}" TextWrapping="Wrap" Text="{Binding XReportText}" />
                    </Border>
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding InfoMessage}"
                        Visibility="{Binding InfoMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
