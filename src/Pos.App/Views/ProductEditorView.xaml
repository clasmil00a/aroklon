<UserControl
    x:Class="Pos.App.Views.ProductEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Path bar -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali ke daftar produk" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Style="{StaticResource Text.Body}"
                    Text="Manajemen" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Text="•" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Style="{StaticResource Text.Body}"
                    Text="Produk" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Text="•" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="{StaticResource Font.Weight.SemiBold}"
                    Foreground="{DynamicResource Brush.Text}"
                    Style="{StaticResource Text.Body}"
                    Text="{Binding EditorTitle}" />
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource Brush.Bg}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <StackPanel
                Margin="10,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="88"
                    Height="64"
                    Command="{Binding SaveProductCommand}"
                    Style="{StaticResource Button.Ghost}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="24"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE74E;" />
                        <TextBlock
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="Simpan" />
                    </StackPanel>
                </Button>
                <Button
                    Width="88"
                    Height="64"
                    Command="{Binding ViewPricesCommand}"
                    IsEnabled="{Binding IsExistingProduct}"
                    Style="{StaticResource Button.Ghost}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="22"
                            Foreground="{DynamicResource Brush.Text}"
                            Text="&#xE8EC;" />
                        <TextBlock
                            Margin="0,7,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Text}"
                            Text="Daftar harga" />
                    </StackPanel>
                </Button>
                <Button
                    Width="88"
                    Height="64"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource Button.Ghost}">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="22"
                            Foreground="{DynamicResource Brush.Text}"
                            Text="&#xE72B;" />
                        <TextBlock
                            Margin="0,7,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Text}"
                            Text="Kembali" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            CanContentScroll="False"
            PanningMode="VerticalOnly">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Core product form -->
                <Border Grid.Column="0" Style="{StaticResource Card.Raised}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Detail produk" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Nama produk *" />
                        <TextBox
                            Style="{StaticResource Input}"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Kode / SKU" />
                                <TextBox
                                    Style="{StaticResource Input}"
                                    Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Barcode" />
                                <TextBox
                                    IsEnabled="{Binding IsNewProduct}"
                                    Style="{StaticResource Input}"
                                    Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Grup produk" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                DisplayMemberPath="Name"
                                Height="40"
                                ItemsSource="{Binding GroupOptions}"
                                SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                Command="{Binding ClearGroupCommand}"
                                Content="&#xE711;"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Tanpa grup" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Satuan dasar *" />
                        <ComboBox
                            DisplayMemberPath="Name"
                            Height="40"
                            IsEnabled="{Binding IsNewProduct}"
                            ItemsSource="{Binding UnitOptions}"
                            SelectedItem="{Binding SelectedBaseUnit, Mode=TwoWay}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Harga jual (Rp) *" />
                                <TextBox
                                    Style="{StaticResource Input}"
                                    Text="{Binding PriceMinor, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Harga beli (Rp)" />
                                <TextBox
                                    Style="{StaticResource Input}"
                                    Text="{Binding CostMinor, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Stok awal (satuan dasar)" />
                            <TextBox
                                Style="{StaticResource Input}"
                                Text="{Binding OpeningStock, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <CheckBox
                            Margin="0,12,0,0"
                            Content="Produk jasa (tanpa stok)"
                            IsChecked="{Binding IsService, Mode=TwoWay}" />
                        <CheckBox
                            Margin="0,8,0,0"
                            Content="Harga boleh diubah saat penjualan"
                            IsChecked="{Binding PriceChangeAllowed, Mode=TwoWay}" />

                        <Button
                            Height="44"
                            Margin="0,18,0,0"
                            Command="{Binding SaveProductCommand}"
                            Content="Simpan produk"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource Button.Primary}" />

                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Text.Error}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Text.Secondary}"
                            Text="{Binding InfoMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Selling unit variants -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Visibility="{Binding ShowNewProductHint, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Simpan produk terlebih dahulu" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource Text.Secondary}"
                                Text="Setelah produk dibuat, Anda dapat menambahkan satuan jual seperti bungkus, renteng, atau dus beserta harganya."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,16,0,0"
                                Style="{StaticResource Text.BodyStrong}"
                                Text="Langkah cepat" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="1. Isi nama, satuan dasar, dan harga jual." />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="2. Klik Simpan produk." />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="3. Tambahkan varian satuan pada panel ini." />
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource Card.Raised}"
                        Visibility="{Binding ShowVariantEditor, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Varian satuan jual" />
                            <TextBlock
                                Margin="0,4,0,10"
                                Style="{StaticResource Text.Caption}"
                                Text="Stok selalu dihitung dalam satuan dasar." />

                            <ItemsControl ItemsSource="{Binding Detail.Variants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            MinHeight="44"
                                            Margin="0"
                                            Padding="8,0"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource Brush.SurfaceRaised}"
                                            BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding UnitName}" />
                                                    <TextBlock
                                                        Style="{StaticResource Text.Caption}"
                                                        Text="{Binding FactorToBaseMilli, StringFormat='1 {0:N0} satuan dasar'}" />
                                                    <TextBlock
                                                        Style="{StaticResource Text.Secondary}"
                                                        Text="{Binding PriceMinor, Converter={StaticResource Currency}, TargetNullValue='Harga induk'}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Text.Caption}"
                                                    Text="{Binding StockDisplay}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="6,0,0,0"
                                                    Padding="8,4"
                                                    Command="{Binding DataContext.ToggleVariantActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding Active, Converter={StaticResource BoolToText}, ConverterParameter='Aktif|Nonaktif'}"
                                                    Style="{StaticResource Button.Ghost}" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button
                                                        Width="28"
                                                        Height="28"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.EditVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE70F;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Style="{StaticResource Button.Ghost}" />
                                                    <Button
                                                        Width="28"
                                                        Height="28"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DeleteVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Style="{StaticResource Button.Ghost}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border
                                Margin="0,14,0,0"
                                Padding="12,14,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Tambah varian" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Satuan" />
                                    <ComboBox
                                        DisplayMemberPath="Name"
                                        Height="40"
                                        ItemsSource="{Binding UnitOptions}"
                                        SelectedItem="{Binding NewUnitOption, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Faktor (1 satuan = X satuan dasar)" />
                                    <TextBox
                                        Style="{StaticResource Input}"
                                        Text="{Binding NewFactor, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Harga jual (kosong = harga induk)" />
                                    <TextBox
                                        Style="{StaticResource Input}"
                                        Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,10,0,0"
                                        Content="Jadikan satuan jual default"
                                        IsChecked="{Binding NewIsDefaultSale, Mode=TwoWay}" />
                                    <Button
                                        Margin="0,12,0,0"
                                        Command="{Binding AddVariantCommand}"
                                        Content="Tambah varian"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Style="{StaticResource Button.Primary}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource Text.Caption}"
                                        Text="Satuan diambil dari Master Satuan, misalnya pcs, bungkus, renteng, dus, kg."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Edit variant -->
                            <Border
                                Margin="0,14,0,0"
                                Padding="12,14,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding EditingVariantId, Converter={StaticResource StringToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Edit varian" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Faktor" />
                                    <TextBox
                                        Style="{StaticResource Input}"
                                        Text="{Binding EditingFactor, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Harga jual (kosong = harga induk)" />
                                    <TextBox
                                        Style="{StaticResource Input}"
                                        Text="{Binding EditingPrice, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,10,0,0"
                                        Content="Jadikan satuan jual default"
                                        IsChecked="{Binding EditingIsDefaultSale, Mode=TwoWay}" />
                                    <CheckBox
                                        Margin="0,8,0,0"
                                        Content="Aktif"
                                        IsChecked="{Binding EditingActive, Mode=TwoWay}" />
                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                        <Button
                                            Width="100"
                                            Margin="0,0,8,0"
                                            Command="{Binding UpdateVariantCommand}"
                                            Content="Simpan"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Style="{StaticResource Button.Primary}" />
                                        <Button
                                            Width="100"
                                            Command="{Binding CancelEditVariantCommand}"
                                            Content="Batal"
                                            Style="{StaticResource Button.Secondary}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource Text.Error}"
                                        Text="{Binding EditingError}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding EditingError, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
