<UserControl
    x:Class="Pos.App.Views.PriceListEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}"
    Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Editor Daftar Harga" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="{Binding List.Name, StringFormat='Mengedit {} {0}', TargetNullValue='Daftar Harga'}" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Badge}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="S40 · M2" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.Raised}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Item dan harga" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="10"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.BorderInput}"
                                    BorderThickness="{StaticResource Border.Width}"
                                    CornerRadius="{StaticResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding ProductName}" />
                                            <TextBlock
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding UnitName, TargetNullValue='—'}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.BodyStrong}"
                                            Text="{Binding PriceMinor, StringFormat='Rp {} {0:N0}', TargetNullValue='inherit (!)'}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Caption}"
                                            Text="{Binding IsInherited, Converter={x:Null}, TargetNullValue='warisan'}"
                                            Visibility="{Binding IsInherited, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBox
                                                Width="120"
                                                Margin="0,0,6,0"
                                                Style="{StaticResource Input}"
                                                Text="{Binding DataContext.NewPriceText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Width="70"
                                                Command="{Binding DataContext.SaveItemPriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Simpan"
                                                Style="{StaticResource Button.Primary}" />
                                            <Button
                                                Width="70"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.ClearItemPriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Hapus (!)"
                                                Visibility="{Binding IsNotInherited, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource Button.Ghost}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Price list settings -->
                    <Border
                        Margin="0,16,0,0"
                        Padding="10"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.BorderInput}"
                        BorderThickness="{StaticResource Border.Width}"
                        CornerRadius="{StaticResource Radius.Sm}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Pengaturan daftar harga" />
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Secondary}" Text="{Binding List.Name, StringFormat='{} {0}', TargetNullValue='Daftar Harga'}" />
                            <CheckBox
                                Margin="0,4,0,0"
                                IsChecked="{Binding List.ApplyPromotions, Mode=TwoWay}"
                                Content="Terapkan promosi" />

                            <Button
                                Margin="0,12,0,0"
                                Height="44"
                                Command="{Binding ShowEditFormCommand}"
                                Content="Ubah nama / status"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource Button.Secondary}" />

                            <Button
                                Margin="0,8,0,0"
                                Height="44"
                                Command="{Binding ToggleListActiveCommand}"
                                Content="{Binding List.Active, Converter={StaticResource BoolToText}, ConverterParameter='Nonaktifkan Daftar Harga|Aktifkan Daftar Harga'}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource Button.Ghost}" />

                            <!-- Edit form -->
                            <Border
                                Margin="0,12,0,0"
                                Padding="10"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.BorderInput}"
                                BorderThickness="{StaticResource Border.Width}"
                                CornerRadius="{StaticResource Radius.Sm}"
                                Visibility="{Binding IsEditFormVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Nama daftar harga" />
                                    <TextBox
                                        Style="{StaticResource Input}"
                                        Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,10,0,0"
                                        IsChecked="{Binding EditApplyPromotions, Mode=TwoWay}"
                                        Content="Terapkan promosi" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button
                                            Width="100"
                                            Height="44"
                                            Margin="0,0,12,0"
                                            Command="{Binding UpdateListCommand}"
                                            Content="Simpan"
                                            IsDefault="True"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Style="{StaticResource Button.Primary}" />
                                        <Button
                                            Width="100"
                                            Height="44"
                                            Command="{Binding HideEditFormCommand}"
                                            Content="Batal"
                                            Style="{StaticResource Button.Ghost}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource Text.Error}"
                                        Text="{Binding ErrorMessage}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding InfoMessage}"
                        Visibility="{Binding InfoMessage, Converter={StaticResource BoolToVisibility}}" />

                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding GoBackCommand}"
                        Content="← Kembali ke daftar harga"
                        Style="{StaticResource Button.Ghost}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
