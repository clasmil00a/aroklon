<UserControl
    x:Class="Pos.App.Views.SalesHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="70" />
            <RowDefinition Height="33" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Aronium path strip -->
        <Border Grid.Row="0" Style="{StaticResource Aronium.PathBar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="Manajemen" />
                <TextBlock
                    Margin="7,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="•" />
                <TextBlock Style="{StaticResource Aronium.PathCurrent}" Text="Riwayat penjualan" />
            </StackPanel>
        </Border>

        <!-- Tool bar -->
        <Border Grid.Row="1" Style="{StaticResource Aronium.Toolbar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Cari transaksi">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon.Accent}" Text="&#xE721;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption.Accent}" Text="Cari" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Muat ulang daftar transaksi">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72C;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Muat ulang" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Kembali ke manajemen">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72B;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Kembali" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Search / filter strip -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid Margin="19,0,10,0">
                <Border
                    Width="360"
                    HorizontalAlignment="Left"
                    Style="{StaticResource Aronium.SearchBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Aronium.SearchIcon}" Text="&#xE721;" />
                        <Grid Grid.Column="1">
                            <TextBox
                                x:Name="HistorySearchBox"
                                Height="28"
                                Padding="2,0,8,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Style="{StaticResource Input}"
                                Text="{Binding Filter.Query, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock
                                Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                IsHitTestVisible="False"
                                Text="Nomor struk, pelanggan, atau kasir">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Button
                    Width="88"
                    Height="28"
                    HorizontalAlignment="Left"
                    Margin="368,0,0,0"
                    Command="{Binding SearchCommand}"
                    Content="Cari"
                    Style="{StaticResource Button.Primary}" />
            </Grid>
        </Border>

        <!-- Table header -->
        <Border Grid.Row="3" Style="{StaticResource Aronium.TableHeader}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Aronium.TableHeaderText}" Text="Nomor" />
                <TextBlock Grid.Column="1" Style="{StaticResource Aronium.TableHeaderText}" Text="Tanggal" />
                <TextBlock Grid.Column="2" Style="{StaticResource Aronium.TableHeaderText}" Text="Pelanggan" />
                <TextBlock Grid.Column="3" Style="{StaticResource Aronium.TableHeaderText}" Text="Kasir" />
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.TableHeaderText}"
                    Text="Item" />
                <TextBlock
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.TableHeaderText}"
                    Text="Total" />
                <TextBlock Grid.Column="6" Style="{StaticResource Aronium.TableHeaderText}" Text="Status" />
                <TextBlock
                    Grid.Column="7"
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.TableHeaderText}"
                    Text="Aksi" />
            </Grid>
        </Border>

        <!-- Sales table -->
        <Grid Grid.Row="4">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                CanContentScroll="False"
                PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding SaleList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Aronium.TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource Aronium.TableCell}" Text="{Binding Number}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource Aronium.TableCell.Muted}"
                                        Text="{Binding CreatedAt}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource Aronium.TableCell}"
                                        Text="{Binding CustomerName, TargetNullValue='(umum)'}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Style="{StaticResource Aronium.TableCell.Muted}"
                                        Text="{Binding UserName}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Aronium.TableCell.Muted}"
                                        Text="{Binding ItemCount}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Aronium.TableCell}"
                                        Text="{Binding TotalMinor, Converter={StaticResource Currency}}" />
                                    <TextBlock Grid.Column="6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Aronium.TableCell}">
                                                <Setter Property="Text" Value="{Binding Status}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="voided">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button
                                        Grid.Column="7"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Buka"
                                        Style="{StaticResource Aronium.LinkButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Brush.TextMuted}"
                Text="Belum ada transaksi untuk pencarian ini.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaleList.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="5" Style="{StaticResource Aronium.Footer}">
            <Grid Margin="12,0">
                <TextBlock
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding SaleList.Count, StringFormat='{}{0} transaksi'}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding InfoMessage}"
                    Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Foreground="{DynamicResource Brush.Danger}"
                    Text="{Binding ErrorMessage}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>