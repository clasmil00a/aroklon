<UserControl
    x:Class="Pos.App.Views.TaxRateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Aronium path strip -->
        <Border Grid.Row="0" Style="{StaticResource Aronium.PathBar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="Manajemen" />
                <TextBlock
                    Margin="7,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="•" />
                <TextBlock Style="{StaticResource Aronium.PathCurrent}" Text="Tarif pajak" />
            </StackPanel>
        </Border>

        <!-- Tool bar -->
        <Border Grid.Row="1" Style="{StaticResource Aronium.Toolbar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Muat ulang daftar tarif pajak">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72C;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Muat ulang" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Simpan tarif pajak">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon.Accent}" Text="&#xE710;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption.Accent}" Text="Simpan" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding ToggleTaxEnabledCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Aktifkan atau nonaktifkan pajak global">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE71F;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Status pajak" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Bersihkan form">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE74D;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Bersihkan" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Kembali ke manajemen">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72B;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Kembali" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Two-pane content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
                <StackPanel Margin="20,16,20,16">
                    <TextBlock Style="{StaticResource Aronium.SectionHeading}" Text="Tarif pajak baru" />

                    <TextBlock Style="{StaticResource Aronium.FieldLabel}" Text="NAMA" />
                    <TextBox
                        Height="32"
                        Style="{StaticResource Input}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Aronium.FieldLabel}" Text="TARIF (BASIS POIN)" />
                    <TextBox
                        Height="32"
                        Style="{StaticResource Input}"
                        Text="{Binding RateBp, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox
                        Margin="0,14,0,0"
                        Content="Tarif bawaan"
                        IsChecked="{Binding IsDefault}" />
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="Pajak diaktifkan secara global"
                        IsChecked="{Binding TaxEnabled, Mode=TwoWay}" />

                    <Button
                        Height="32"
                        Margin="0,18,0,0"
                        Command="{Binding SaveCommand}"
                        Content="Simpan tarif"
                        IsDefault="True"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Primary}" />
                    <Button
                        Height="32"
                        Margin="0,8,0,0"
                        Command="{Binding ToggleTaxEnabledCommand}"
                        Content="Ubah status pajak"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Secondary}" />
                    <Button
                        Height="32"
                        Margin="0,8,0,0"
                        Command="{Binding ClearCommand}"
                        Content="Bersihkan"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Ghost}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding InfoMessage}"
                        Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Border}" />

            <!-- Rate list -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Bg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Aronium.PanelHeader}">
                        <Grid Margin="12,0">
                            <TextBlock Style="{StaticResource Aronium.PanelHeaderText}" Text="Daftar tarif pajak" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.StatusText}"
                                Text="{Binding TaxRates.Count, StringFormat='{}{0} tarif'}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Aronium.TableHeaderText}" Text="Nama" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Aronium.TableHeaderText}" Text="Tarif" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Aronium.TableHeaderText}" Text="Status" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.TableHeaderText}"
                                Text="Aksi" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding TaxRates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Aronium.TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Aronium.TableCell}" Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource Aronium.TableCell.Muted}"
                                                Text="{Binding RateBp, StringFormat='{}{0:N2}%'}" />
                                            <TextBlock Grid.Column="2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Aronium.TableCell}">
                                                        <Setter Property="Text" Value="Nonaktif" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Active}" Value="True">
                                                                <Setter Property="Text" Value="Aktif" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="Text" Value="Bawaan" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel
                                                Grid.Column="3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Height="28"
                                                    Padding="10,0"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Ubah"
                                                    Style="{StaticResource Aronium.LinkButton}" />
                                                <Button
                                                    Height="28"
                                                    Margin="4,0,0,0"
                                                    Padding="10,0"
                                                    Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Nonaktifkan"
                                                    Style="{StaticResource Aronium.LinkButton}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="3" Style="{StaticResource Aronium.Footer}">
            <Grid Margin="12,0">
                <TextBlock
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding TaxRates.Count, StringFormat='{}{0} tarif pajak'}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding ErrorMessage}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
