<UserControl
    x:Class="Pos.App.Views.RefundView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="70" />
            <RowDefinition Height="33" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Aronium path strip -->
        <Border Grid.Row="0" Style="{StaticResource Aronium.PathBar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="Kasir" />
                <TextBlock
                    Margin="7,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="•" />
                <TextBlock Style="{StaticResource Aronium.PathCurrent}" Text="Refund transaksi" />
            </StackPanel>
        </Border>

        <!-- Tool bar -->
        <Border Grid.Row="1" Style="{StaticResource Aronium.Toolbar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding SearchSaleCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Cari transaksi asli">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon.Accent}" Text="&#xE721;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption.Accent}" Text="Cari" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding SubmitRefundCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Proses refund">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE8A3;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Refund" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Kembali ke kasir">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72B;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Kembali" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Search strip -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid Margin="19,0,10,0">
                <Border
                    Width="360"
                    HorizontalAlignment="Left"
                    Style="{StaticResource Aronium.SearchBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Aronium.SearchIcon}" Text="&#xE721;" />
                        <Grid Grid.Column="1">
                            <TextBox
                                x:Name="SaleNumberBox"
                                Height="28"
                                Padding="2,0,8,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Style="{StaticResource Input}"
                                Text="{Binding SaleNumberQuery, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchSaleCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock
                                Margin="3,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                IsHitTestVisible="False"
                                Text="Nomor struk transaksi asli">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SaleNumberBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Button
                    Width="120"
                    Height="28"
                    HorizontalAlignment="Left"
                    Margin="368,0,0,0"
                    Command="{Binding SearchSaleCommand}"
                    Content="Cari Transaksi"
                    Style="{StaticResource Button.Primary}" />
            </Grid>
        </Border>

        <!-- Two-pane content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Original sale -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Aronium.PanelHeader}">
                        <TextBlock Margin="12,0" Style="{StaticResource Aronium.PanelHeaderText}" Text="Transaksi asli" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="16">
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding OriginalSaleNumber, TargetNullValue='—'}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Secondary}"
                            Text="{Binding OriginalSaleTotal, TargetNullValue='—'}" />
                        <TextBlock
                            Margin="0,16,0,0"
                            Style="{StaticResource Text.Caption}"
                            Text="Pilih baris di kanan untuk direfund."
                            Visibility="{Binding SaleFound, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock
                            Margin="0,16,0,0"
                            Style="{StaticResource Text.Error}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Border}" />

            <!-- Refund lines + payment -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Bg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Aronium.PanelHeader}">
                        <Grid Margin="12,0">
                            <TextBlock Style="{StaticResource Aronium.PanelHeaderText}" Text="Baris yang akan direfund" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.StatusText}"
                                Text="{Binding RefundLines.Count, StringFormat='{}{0} baris'}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Aronium.TableHeaderText}" Text="Produk" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Aronium.TableHeaderText}" Text="Satuan" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.TableHeaderText}"
                                Text="Sisa" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.TableHeaderText}"
                                Text="Qty refund" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.TableHeaderText}"
                                Text="Total" />
                            <TextBlock Grid.Column="5" Style="{StaticResource Aronium.TableHeaderText}" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding RefundLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Aronium.TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Aronium.TableCell}" Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource Aronium.TableCell.Muted}"
                                                Text="{Binding UnitName, TargetNullValue='—'}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource Aronium.TableCell.Muted}"
                                                Text="{Binding RefundableQtyMilli, StringFormat='{}{0:0.###}'}" />
                                            <TextBox
                                                Grid.Column="3"
                                                Width="90"
                                                Height="26"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource Input}"
                                                Text="{Binding RefundQtyMilli, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource Aronium.TableCell}"
                                                Text="{Binding LineTotalMinor, Converter={StaticResource Currency}}" />
                                            <Button
                                                Grid.Column="5"
                                                Width="28"
                                                Height="28"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.RefundFullCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="×"
                                                Style="{StaticResource Aronium.LinkButton}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Refund payment -->
                    <Border
                        Grid.Row="3"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                        <TextBlock Margin="12,0" Style="{StaticResource Aronium.PanelHeaderText}" Text="Pembayaran refund" />
                    </Border>
                    <StackPanel
                        Grid.Row="4"
                        Margin="16,12,16,16"
                        Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Background="{DynamicResource Brush.Bg}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        GroupName="RefundPayment"
                                        IsChecked="{Binding PaymentTypeId, Converter={StaticResource StringEquals}, ConverterParameter='pmt-cash', Mode=TwoWay}"
                                        Content="Tunai"
                                        Style="{StaticResource Segment}" />
                                    <RadioButton
                                        GroupName="RefundPayment"
                                        IsChecked="{Binding PaymentTypeId, Converter={StaticResource StringEquals}, ConverterParameter='pmt-card', Mode=TwoWay}"
                                        Content="Kartu"
                                        Style="{StaticResource Segment}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.Caption}"
                                Text="Diterima" />
                            <TextBox
                                Width="140"
                                Height="30"
                                Margin="8,0,0,0"
                                Style="{StaticResource Input}"
                                Text="{Binding TenderedAmount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.Caption}"
                                Text="Alasan" />
                            <TextBox
                                Width="220"
                                Height="30"
                                Margin="8,0,0,0"
                                Style="{StaticResource Input}"
                                Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button
                            Height="30"
                            Margin="16,0,0,0"
                            Command="{Binding SubmitRefundCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Content="Proses Refund"
                            Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="4" Style="{StaticResource Aronium.Footer}">
            <Grid Margin="12,0">
                <TextBlock
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding RefundLines.Count, StringFormat='{}{0} baris refund'}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding InfoMessage}"
                    Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Foreground="{DynamicResource Brush.Danger}"
                    Text="{Binding ErrorMessage}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
