<UserControl
    x:Class="Pos.App.Views.ProductListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Width" Value="49" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="RailButton.Selected" TargetType="Button">
            <Setter Property="Width" Value="49" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ProductRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Row"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.SurfaceRaised}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SelectedRow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Aronium path strip -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali ke manajemen" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Text="Manajemen" />
                <TextBlock
                    Margin="7,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Text="•" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource Brush.Text}"
                    Text="Produk" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="49" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Management icon rail -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <Button
                        Command="{Binding OpenReportsCommand}"
                        Content="&#xE9D2;"
                        Style="{StaticResource RailButton}"
                        ToolTip="Laporan" />
                    <Button
                        Command="{Binding OpenHistoryCommand}"
                        Content="&#xE81C;"
                        Style="{StaticResource RailButton}"
                        ToolTip="Riwayat penjualan" />
                    <Button
                        Content="&#xE7BF;"
                        Style="{StaticResource RailButton.Selected}"
                        ToolTip="Produk" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="33" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <!-- Aronium management toolbar -->
                <Border
                    Grid.Row="0"
                    Background="{DynamicResource Brush.Bg}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                    <StackPanel
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="Muat ulang daftar produk">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE72C;" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Muat ulang" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding OpenProductGroupsCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="Kelola grup produk">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE8F4;" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Grup produk" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding OpenReportsCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="Buka laporan">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE9D2;" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Laporan" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding OpenHistoryCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="Riwayat penjualan">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE81C;" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Riwayat" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NewProductCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="Tambah produk baru">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="24"
                                    Foreground="{DynamicResource Brush.Accent}"
                                    Text="&#xE710;" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.Accent}"
                                    Text="Produk baru" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding EditSelectedProductCommand}"
                            IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource ToolButton}"
                            ToolTip="Edit produk terpilih">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE70F;" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Edit produk" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Category tab + search mode bar -->
                <Border
                    Grid.Row="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="80"
                            Height="28"
                            Margin="19,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Accent}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Foreground="{DynamicResource Brush.OnAccent}"
                                    Text="&#xE8B7;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.OnAccent}"
                                    Text="Produk" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Width="360"
                            Height="30"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Bg}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="31" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="31" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="15"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xEC5A;" />
                                <Border
                                    Grid.Column="1"
                                    Background="{DynamicResource Brush.Border}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="{StaticResource Font.Weight.SemiBold}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="123" />
                                <Border
                                    Grid.Column="3"
                                    Background="{DynamicResource Brush.Border}" />
                                <Border
                                    Grid.Column="4"
                                    Background="{DynamicResource Brush.Accent}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.OnAccent}"
                                        Text="&#xE8EC;" />
                                </Border>
                                <Grid Grid.Column="5">
                                    <TextBox
                                        x:Name="ProductSearchBox"
                                        Height="28"
                                        Padding="9,0"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Style="{StaticResource Input}"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        IsHitTestVisible="False"
                                        Text="Nama produk">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ProductSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Products table -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{DynamicResource Brush.Bg}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Nama produk" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Kode" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Grup" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Harga" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Stok" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Satuan" />
                        </Grid>
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ProductRow}"
                        ItemsSource="{Binding ProductList}"
                        MouseDoubleClick="OnProductDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                        Style="{StaticResource ListBox.Plain}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="44" Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            Opacity="0.7"
                                            Text="{Binding Barcode, TargetNullValue='—'}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Opacity="0.7"
                                        Text="{Binding Code, TargetNullValue='—'}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Opacity="0.7"
                                        Text="{Binding GroupName, TargetNullValue='—'}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Text="{Binding PriceMinor, Converter={StaticResource Currency}}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Opacity="0.7"
                                        Text="{Binding StockDisplay}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Opacity="0.7"
                                        Text="{Binding UnitName}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Belum ada produk. Klik Produk baru untuk menambahkan."
                        Visibility="{Binding HasNoProducts, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border
                    Grid.Row="3"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="{Binding ProductList.Count, StringFormat='{}{0} produk'}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.Danger}"
                            Text="{Binding ErrorMessage}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
