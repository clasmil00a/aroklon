<UserControl
    x:Class="Pos.App.Views.CashMovementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}"
    Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Kas Masuk / Keluar" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="Catat uang masuk dan keluar dari laci kas register." />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Badge}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="S31 · M4" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Gerakan kas baru" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Arah" />
                    <Border
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.BorderInput}"
                        BorderThickness="{StaticResource Border.Width}"
                        CornerRadius="{StaticResource Radius.Sm}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                GroupName="CashDirection"
                                IsChecked="{Binding Direction, Converter={StaticResource StringEquals}, ConverterParameter='in'}"
                                Content="Masuk"
                                Style="{StaticResource Segment}" />
                            <RadioButton
                                GroupName="CashDirection"
                                IsChecked="{Binding Direction, Converter={StaticResource StringEquals}, ConverterParameter='out'}"
                                Content="Keluar"
                                Style="{StaticResource Segment}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,10,0,6" Style="{StaticResource Text.Caption}" Text="Jumlah" />
                    <TextBox
                        Style="{StaticResource Input}"
                        Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,6" Style="{StaticResource Text.Caption}" Text="Alasan" />
                    <TextBox
                        Style="{StaticResource Input}"
                        Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Margin="0,16,0,0"
                        Height="44"
                        Command="{Binding SaveCommand}"
                        Content="Simpan Gerakan"
                        IsDefault="True"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Primary}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding InfoMessage}"
                        Visibility="{Binding InfoMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- List -->
            <Border Grid.Column="2" Style="{StaticResource Card.Raised}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Riwayat gerakan kas" />
                    <ItemsControl ItemsSource="{Binding Movements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="10"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.BorderInput}"
                                    BorderThickness="{StaticResource Border.Width}"
                                    CornerRadius="{StaticResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Reason}" />
                                            <TextBlock
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding Direction, Converter={StaticResource StringMap}, ConverterParameter='in=Masuk;out=Keluar'}"
                                                Foreground="{DynamicResource Brush.Success}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.BodyStrong}"
                                            Text="{Binding AmountMinor, StringFormat='Rp {0:N0}'}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Caption}"
                                            Text="{Binding CreatedAt}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Caption}"
                        Text="{Binding Movements.Count, StringFormat='{}{0} gerakan'}" />

                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding GoBackCommand}"
                        Content="← Kembali ke beranda"
                        Style="{StaticResource Button.Ghost}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
