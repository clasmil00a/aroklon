<UserControl
    x:Class="Pos.App.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}"
    Loaded="OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="48" MaxWidth="1040" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Border
                        Width="44"
                        Height="44"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="{StaticResource Radius.Md}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="{StaticResource Font.Weight.Bold}"
                            Foreground="{DynamicResource Brush.OnAccent}"
                            Text="P" />
                    </Border>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource Font.Size.Xl}"
                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                        Text="POS" />
                </StackPanel>

                <TextBlock
                    Style="{StaticResource Text.PageTitle}"
                    Text="Siapkan toko Anda"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,12,0,28"
                    MaxWidth="480"
                    HorizontalAlignment="Left"
                    Style="{StaticResource Text.Body}"
                    Text="Buat identitas toko dan akun administrator pertama. Database lokal dibuat otomatis, jadi Anda bisa langsung mulai tanpa konfigurasi server."
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                    <Border
                        Width="28"
                        Height="28"
                        Background="{DynamicResource Brush.SurfaceRaised}"
                        CornerRadius="{StaticResource Radius.Sm}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="1" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" MaxWidth="420">
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Identitas toko" />
                        <TextBlock
                            Style="{StaticResource Text.Secondary}"
                            Text="Nama ini muncul di struk dan kepala halaman."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                    <Border
                        Width="28"
                        Height="28"
                        Background="{DynamicResource Brush.SurfaceRaised}"
                        CornerRadius="{StaticResource Radius.Sm}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="2" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" MaxWidth="420">
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Akun administrator" />
                        <TextBlock
                            Style="{StaticResource Text.Secondary}"
                            Text="Akun ini dapat mengelola pengguna, harga, dan cadangan."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="28"
                        Height="28"
                        Background="{DynamicResource Brush.SurfaceRaised}"
                        CornerRadius="{StaticResource Radius.Sm}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="3" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" MaxWidth="420">
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Database lokal" />
                        <TextBlock
                            Style="{StaticResource Text.Secondary}"
                            Text="Data tersimpan di komputer ini dan dicadangkan setiap hari."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border
                Grid.Column="2"
                Padding="28"
                VerticalAlignment="Center"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Akun administrator" />
                    <TextBlock
                        Margin="0,0,0,20"
                        Style="{StaticResource Text.Secondary}"
                        Text="Isi data toko dan pemilik. Anda dapat mengubahnya nanti di Manajemen."
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Nama toko" />
                    <TextBox
                        x:Name="ShopNameBox"
                        Margin="0,0,0,12"
                        Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Nama lengkap" />
                    <TextBox
                        x:Name="OwnerNameBox"
                        Margin="0,0,0,12"
                        Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Nama pengguna" />
                    <TextBox
                        x:Name="UsernameBox"
                        Margin="0,0,0,12"
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Kata sandi" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Margin="0,0,0,12"
                        PasswordChanged="OnPasswordChanged" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Ulangi kata sandi" />
                    <PasswordBox
                        x:Name="ConfirmBox"
                        PasswordChanged="OnConfirmPasswordChanged" />

                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <Button
                        Height="44"
                        Margin="0,18,0,0"
                        Command="{Binding SubmitCommand}"
                        Content="Buat akun &amp; mulai"
                        IsDefault="True"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Primary}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Text.Caption}"
                        Text="Menyiapkan database..."
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Margin="0,14,0,0"
                        Style="{StaticResource Text.Caption}"
                        Text="Minimal 8 karakter. Gunakan kata sandi yang tidak dipakai di layanan lain."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
