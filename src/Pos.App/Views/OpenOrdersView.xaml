<UserControl
    x:Class="Pos.App.Views.OpenOrdersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="70" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Aronium path strip -->
        <Border Grid.Row="0" Style="{StaticResource Aronium.PathBar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="Kasir" />
                <TextBlock
                    Margin="7,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="•" />
                <TextBlock Style="{StaticResource Aronium.PathCurrent}" Text="Pesanan terbuka" />
            </StackPanel>
        </Border>

        <!-- Tool bar -->
        <Border Grid.Row="1" Style="{StaticResource Aronium.Toolbar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Muat ulang daftar pesanan terbuka">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72C;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Muat ulang" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Kembali ke kasir">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72B;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Kembali" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Table header -->
        <Border Grid.Row="2" Style="{StaticResource Aronium.TableHeader}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Aronium.TableHeaderText}" Text="Nomor" />
                <TextBlock Grid.Column="1" Style="{StaticResource Aronium.TableHeaderText}" Text="Dibuat" />
                <TextBlock Grid.Column="2" Style="{StaticResource Aronium.TableHeaderText}" Text="Pelanggan" />
                <TextBlock Grid.Column="3" Style="{StaticResource Aronium.TableHeaderText}" Text="Kasir" />
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.TableHeaderText}"
                    Text="Item" />
                <TextBlock
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.TableHeaderText}"
                    Text="Total" />
                <TextBlock Grid.Column="6" Style="{StaticResource Aronium.TableHeaderText}" Text="Catatan" />
                <TextBlock
                    Grid.Column="7"
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.TableHeaderText}"
                    Text="Aksi" />
            </Grid>
        </Border>

        <!-- Open orders table -->
        <Grid Grid.Row="3">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                CanContentScroll="False"
                PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Aronium.TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Aronium.TableCell}" Text="{Binding Number}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource Aronium.TableCell.Muted}"
                                        Text="{Binding CreatedAt}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource Aronium.TableCell}"
                                        Text="{Binding CustomerName, TargetNullValue='(umum)'}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Style="{StaticResource Aronium.TableCell.Muted}"
                                        Text="{Binding UserName}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Aronium.TableCell.Muted}"
                                        Text="{Binding ItemCount}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Aronium.TableCell}"
                                        Text="{Binding TotalMinor, Converter={StaticResource Currency}}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Style="{StaticResource Aronium.TableCell.Muted}"
                                        Text="{Binding Note, TargetNullValue='—'}" />
                                    <Button
                                        Grid.Column="7"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Lanjutkan"
                                        Style="{StaticResource Aronium.LinkButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Brush.TextMuted}"
                Text="Belum ada pesanan yang ditahan.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Orders.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="4" Style="{StaticResource Aronium.Footer}">
            <Grid Margin="12,0">
                <TextBlock
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding Orders.Count, StringFormat='{}{0} pesanan terbuka'}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding ErrorMessage}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
