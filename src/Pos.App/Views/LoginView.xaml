<UserControl
    x:Class="Pos.App.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}"
    Loaded="OnLoaded">

    <Grid>
        <Border
            Width="420"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border
                        Width="48"
                        Height="48"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="{StaticResource Radius.Md}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="{StaticResource Font.Weight.Bold}"
                            Foreground="{DynamicResource Brush.OnAccent}"
                            Text="A" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="{StaticResource Font.Size.Xl}"
                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                            Text="Aroklon" />
                        <TextBlock
                            Style="{StaticResource Text.Secondary}"
                            Text="{Binding ShopName}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource Text.DialogTitle}"
                    Text="Masuk ke kasir" />
                <TextBlock
                    Margin="0,0,0,24"
                    Style="{StaticResource Text.Secondary}"
                    Text="Gunakan akun yang diberikan administrator toko."
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource Text.Caption}"
                    Text="Nama pengguna" />
                <TextBox
                    x:Name="UsernameBox"
                    Margin="0,0,0,14"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource Text.Caption}"
                    Text="Kata sandi" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Margin="0,0,0,4"
                    PasswordChanged="OnPasswordChanged" />

                <CheckBox
                    Margin="0,10,0,0"
                    Content="Ingat nama pengguna terakhir"
                    IsChecked="{Binding RememberUsername, Mode=TwoWay}" />

                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource Text.Error}"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <Button
                    Height="44"
                    Margin="0,16,0,0"
                    Command="{Binding SignInCommand}"
                    Content="Masuk"
                    IsDefault="True"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Button.Primary}" />

                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="Memeriksa akun..."
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding Version, StringFormat=Versi {0} · Data tersimpan lokal}" />

                <Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Command="{Binding ExitCommand}"
                    Content="Keluar aplikasi"
                    Style="{StaticResource Button.Ghost}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
