<UserControl
    x:Class="Pos.App.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseMenuCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <ContentControl Content="{Binding CurrentPage}" />

        <!-- Aronium-style main menu: 294px flyout from the right edge. -->
        <Grid
            Panel.ZIndex="50"
            Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="294" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{DynamicResource Brush.Scrim}"
                MouseLeftButtonDown="OnMenuBackdropMouseDown" />

            <Border
                Grid.Column="1"
                Background="{DynamicResource Brush.MenuPanel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1,0,0,0"
                Effect="{DynamicResource Effect.Pop}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="73" />
                    </Grid.RowDefinitions>

                    <!-- Menu header -->
                    <Border
                        Grid.Row="0"
                        Padding="20,0,12,0"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Font.Size.Lg}"
                                FontWeight="{StaticResource Font.Weight.Regular}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="{Binding MenuHeader}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding SignOutCommand}"
                                Content="&#xE72A;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{DynamicResource Brush.Text}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Ganti pengguna" />
                        </Grid>
                    </Border>

                    <!-- Menu items -->
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border
                                            Height="1"
                                            Margin="0"
                                            Background="{DynamicResource Brush.Border}"
                                            Visibility="{Binding SeparatorBefore, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Margin="8,14,8,2"
                                            FontSize="{StaticResource Font.Size.Sm}"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Text="{Binding Section}"
                                            Visibility="{Binding Section, Converter={StaticResource StringToVisibility}}" />
                                        <Button
                                            Height="55"
                                            Padding="18,0,12,0"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Route}"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource Button.Menu}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="18"
                                                    Foreground="{DynamicResource Brush.Text}"
                                                    Text="{Binding Icon}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource Font.Size.Base}"
                                                    Foreground="{DynamicResource Brush.Text}"
                                                    Text="{Binding Label}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Text.Caption}"
                                                    Text="{Binding Shortcut}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Date -->
                    <Border Grid.Row="2">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource Font.Size.Lg}"
                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="{Binding MenuDate}" />
                    </Border>

                    <!-- Settings / fullscreen / power -->
                    <Border
                        Grid.Row="3"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding NavigateCommand}"
                                CommandParameter="settings"
                                Content="&#xE9E9;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{DynamicResource Brush.Text}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Pengaturan" />
                            <Button
                                Margin="22,0,0,0"
                                Command="{Binding ToggleWindowCommand}"
                                Content="&#xE740;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{DynamicResource Brush.Text}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Perbesar / kecilkan jendela" />
                            <Button
                                Margin="22,0,0,0"
                                Command="{Binding ExitCommand}"
                                Content="&#xE7E8;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{DynamicResource Brush.Text}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Keluar aplikasi" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
