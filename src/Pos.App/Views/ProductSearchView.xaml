<UserControl
    x:Class="Aroklon.App.Views.ProductSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}"
    Loaded="OnLoaded"
    KeyDown="OnKeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel Margin="16">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Cari Produk (F3)" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="Cari by nama atau kode produk. Panah atas/bawah untuk navigasi, Enter untuk pilih." TextWrapping="Wrap" />

                <TextBlock Margin="0,12,0,6" Style="{StaticResource Text.Caption}" Text="Cari produk" />
                <TextBox
                    Style="{StaticResource Input}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" />

                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource Text.Caption}"
                    Text="{Binding Results.Count, StringFormat='{}{0} hasil'}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card.Raised}">
            <ListBox
                ItemsSource="{Binding Results}"
                SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                SelectedItem="{Binding SelectedResult, Mode=OneWay}"
                Style="{StaticResource ListBox.Plain}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                MaxHeight="400">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="10"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.BorderInput}"
                            BorderThickness="{StaticResource Border.Width}"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="40" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Code, TargetNullValue='—'}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.BodyStrong}"
                                    Text="{Binding PriceMinor, StringFormat='Rp {0:N0}'}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Caption}"
                                    Text="{Binding UnitName}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button
                Width="100"
                Height="44"
                Margin="0,0,12,0"
                Command="{Binding SelectCurrentCommand}"
                Content="Pilih (Enter)"
                IsDefault="True"
                IsEnabled="{Binding IsNotBusy}"
                Style="{StaticResource Button.Primary}" />
            <Button
                Width="100"
                Height="44"
                Command="{Binding CloseCommand}"
                Content="Tutup (Esc)"
                IsCancel="True"
                IsEnabled="{Binding IsNotBusy}"
                Style="{StaticResource Button.Ghost}" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Style="{StaticResource Text.Error}"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Style="{StaticResource Text.Secondary}"
            Text="{Binding InfoMessage}"
            Visibility="{Binding InfoMessage, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
