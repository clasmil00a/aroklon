<UserControl
    x:Class="Pos.App.Views.ReceiptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Aronium path strip -->
        <Border Grid.Row="0" Style="{StaticResource Aronium.PathBar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="Kasir" />
                <TextBlock
                    Margin="7,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="•" />
                <TextBlock Style="{StaticResource Aronium.PathCurrent}" Text="Struk transaksi" />
            </StackPanel>
        </Border>

        <!-- Tool bar -->
        <Border Grid.Row="1" Style="{StaticResource Aronium.Toolbar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding PrintCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Cetak struk">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon.Accent}" Text="&#xE749;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption.Accent}" Text="Cetak" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding SavePdfCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Simpan sebagai PDF">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE74E;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="PDF" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding EmailCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Email ke pelanggan">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE717;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Email" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding SkipCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Lewati struk">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE74D;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Lewati" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Kembali">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72B;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Kembali" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Two-pane content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Actions -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Aronium.PanelHeader}">
                        <TextBlock Margin="12,0" Style="{StaticResource Aronium.PanelHeaderText}" Text="Aksi struk" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="16">
                        <Button
                            Height="32"
                            Command="{Binding PrintCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Content="Cetak struk"
                            Style="{StaticResource Button.Primary}" />
                        <Button
                            Height="32"
                            Margin="0,8,0,0"
                            Command="{Binding SavePdfCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Content="Simpan sebagai PDF"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            Height="32"
                            Margin="0,8,0,0"
                            Command="{Binding EmailCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Content="Email ke pelanggan"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            Height="32"
                            Margin="0,8,0,0"
                            Command="{Binding SkipCommand}"
                            Content="Lewati struk"
                            Style="{StaticResource Button.Ghost}" />

                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Text.Error}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Text.Secondary}"
                            Text="{Binding InfoMessage}"
                            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Background="{DynamicResource Brush.Bg}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                        <TextBlock Margin="12,0" Style="{StaticResource Aronium.PanelHeaderText}" Text="Detail struk" />
                    </Border>
                    <StackPanel Grid.Row="3" Margin="16">
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Document.Number, TargetNullValue='—'}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Secondary}"
                            Text="{Binding Document.DateText, TargetNullValue='—'}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.BodyStrong}"
                            Text="{Binding Document.TotalMinor, StringFormat='Total: Rp {0:N0}', TargetNullValue='—'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Border}" />

            <!-- Receipt preview -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Bg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Aronium.PanelHeader}">
                        <TextBlock Margin="12,0" Style="{StaticResource Aronium.PanelHeaderText}" Text="Pratinjau struk" />
                    </Border>

                    <Border
                        Grid.Row="1"
                        Margin="16"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                Padding="12"
                                FontFamily="{StaticResource Font.Mono}"
                                FontSize="{StaticResource Font.Size.Sm}"
                                Text="{Binding ReceiptText}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="3" Style="{StaticResource Aronium.Footer}">
            <Grid Margin="12,0">
                <TextBlock
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding Document.Number, TargetNullValue='Struk'}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding InfoMessage}"
                    Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
