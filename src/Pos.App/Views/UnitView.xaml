<UserControl
    x:Class="Pos.App.Views.UnitView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Aronium path strip -->
        <Border Grid.Row="0" Style="{StaticResource Aronium.PathBar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali" />
                <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="Manajemen" />
                <TextBlock
                    Margin="7,0"
                    Style="{StaticResource Aronium.PathText}"
                    Text="•" />
                <TextBlock Style="{StaticResource Aronium.PathCurrent}" Text="Satuan" />
            </StackPanel>
        </Border>

        <!-- Tool bar -->
        <Border Grid.Row="1" Style="{StaticResource Aronium.Toolbar}">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding ExecuteLoadCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Muat ulang daftar satuan">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72C;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Muat ulang" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Simpan satuan">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon.Accent}" Text="&#xE710;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption.Accent}" Text="Simpan" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding CancelEditCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Bersihkan form">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE74D;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Batal" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource Aronium.ToolButton}"
                    ToolTip="Kembali ke manajemen">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Aronium.ToolIcon}" Text="&#xE72B;" />
                        <TextBlock Style="{StaticResource Aronium.ToolCaption}" Text="Kembali" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Two-pane content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
                <StackPanel Margin="20,16,20,16">
                    <TextBlock Style="{StaticResource Aronium.SectionHeading}" Text="Satuan baru" />

                    <TextBlock Style="{StaticResource Aronium.FieldLabel}" Text="NAMA SATUAN" />
                    <TextBox
                        x:Name="NameBox"
                        Height="32"
                        Style="{StaticResource Input}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Aronium.FieldLabel}" Text="SIMBOL (OPSIONAL)" />
                    <TextBox
                        Height="32"
                        Style="{StaticResource Input}"
                        Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="0,14,0,0"
                        Style="{StaticResource Text.Caption}"
                        Text="Contoh: pcs, bungkus, renteng (6 bungkus), dus, kg, g, L, mL, lusin, kodi."
                        TextWrapping="Wrap" />

                    <Button
                        Height="32"
                        Margin="0,18,0,0"
                        Command="{Binding SaveCommand}"
                        Content="Simpan"
                        IsDefault="True"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Primary}" />
                    <Button
                        Height="32"
                        Margin="0,8,0,0"
                        Command="{Binding CancelEditCommand}"
                        Content="Batal"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding InfoMessage}"
                        Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Border}" />

            <!-- Unit list -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Bg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Aronium.PanelHeader}">
                        <Grid Margin="12,0">
                            <TextBlock Style="{StaticResource Aronium.PanelHeaderText}" Text="Daftar satuan" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.StatusText}"
                                Text="{Binding UnitList.Count, StringFormat='{}{0} satuan'}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Aronium.TableHeaderText}" Text="Nama" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Aronium.TableHeaderText}" Text="Simbol" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Aronium.TableHeaderText}"
                                Text="Aksi" />
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding UnitList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Aronium.TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Aronium.TableCell}" Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource Aronium.TableCell.Muted}"
                                                Text="{Binding Symbol, TargetNullValue='—'}" />
                                            <Button
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Ubah"
                                                Style="{StaticResource Aronium.LinkButton}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="3" Style="{StaticResource Aronium.Footer}">
            <Grid Margin="12,0">
                <TextBlock
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding UnitList.Count, StringFormat='{}{0} satuan terdaftar'}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Aronium.FooterText}"
                    Text="{Binding ErrorMessage}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
