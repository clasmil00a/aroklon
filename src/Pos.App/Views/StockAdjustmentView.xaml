<UserControl
    x:Class="Pos.App.Views.StockAdjustmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}"
    Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Penyesuaian Stok" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="Atur stok pada produk secara cepat (penyesuaian dan penerimaan barang)." />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Badge}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="M9 · Stok" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Product selection + adjustment form -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Pilih produk" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Cari produk" />
                    <TextBox
                        Style="{StaticResource Input}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsControl
                        Margin="0,8,0,0"
                        ItemsSource="{Binding ProductList}"
                        MaxHeight="320">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.BorderInput}"
                                    BorderThickness="{StaticResource Border.Width}"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding ProductName}" />
                                            <TextBlock
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding Code}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Content="Pilih"
                                            Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Ghost}"
                                            Padding="8,4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Adjustment detail -->
            <Border Grid.Column="2" Style="{StaticResource Card.Raised}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Sesuaikan stok" />

                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="Produk" />
                    <TextBlock
                        Style="{StaticResource Text.BodyStrong}"
                        Text="{Binding SelectedProductName, FallbackValue='Belum dipilih'}" />

                    <TextBlock Margin="0,10,0,6" Style="{StaticResource Text.Caption}" Text="Stok saat ini" />
                    <TextBlock
                        Style="{StaticResource Text.BodyStrong}"
                        Text="{Binding CurrentStock, StringFormat='{}{0:N0} unit'}" />

                    <TextBlock Margin="0,10,0,6" Style="{StaticResource Text.Caption}" Text="Stok target" />
                    <TextBox
                        Style="{StaticResource Input}"
                        Text="{Binding TargetStock, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,6" Style="{StaticResource Text.Caption}" Text="Alasan" />
                    <TextBox
                        Style="{StaticResource Input}"
                        Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Margin="0,16,0,0"
                        Height="44"
                        Command="{Binding AdjustCommand}"
                        Content="Sesuaikan ke target"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Primary}" />

                    <Button
                        Margin="0,8,0,0"
                        Height="44"
                        Command="{Binding ReceiveCommand}"
                        Content="Terima stok masuk"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource Button.Secondary}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding InfoMessage}"
                        Visibility="{Binding InfoMessage, Converter={StaticResource BoolToVisibility}}" />

                    <Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding GoBackCommand}"
                        Content="← Kembali ke beranda"
                        Style="{StaticResource Button.Ghost}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
