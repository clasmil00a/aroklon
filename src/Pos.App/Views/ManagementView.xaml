<UserControl
    x:Class="Pos.App.Views.ManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}">

    <UserControl.Resources>
        <Style x:Key="ModuleTile" TargetType="Button" BasedOn="{StaticResource Button.Tile}">
            <Setter Property="Width" Value="250" />
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{DynamicResource Brush.SurfaceRaised}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content="&#xE72B;"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Kembali ke kasir" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="{StaticResource Font.Weight.SemiBold}"
                    Style="{StaticResource Text.Body}"
                    Text="Manajemen" />
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            CanContentScroll="False"
            PanningMode="VerticalOnly">
            <StackPanel Margin="24">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Manajemen" />
                <TextBlock
                    Margin="0,4,0,20"
                    Style="{StaticResource Text.Secondary}"
                    Text="Pilih modul untuk mengelola toko. Semua data tersimpan di database lokal." />

                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ModuleTile}">
                                <StackPanel>
                                    <TextBlock
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="26"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="{Binding Icon}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="{StaticResource Font.Size.Lg}"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource Text.Secondary}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Pengaturan aplikasi" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Style="{StaticResource Text.Secondary}"
                                Text="Printer struk, tema, cadangan, dan data perusahaan."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding OpenSettingsCommand}"
                            Content="Buka pengaturan"
                            Style="{StaticResource Button.Secondary}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
