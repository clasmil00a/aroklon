<UserControl
    x:Class="Pos.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="Pengaturan" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="Tampilan, perilaku kasir, struk, dan database lokal." />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Badge}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="S27 · M0" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource TabControl.Settings}">
            <TabItem Header="Umum" Style="{StaticResource TabItem.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Tampilan" />
                                <TextBlock
                                    Margin="0,4,0,12"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="Tema berlaku langsung dan disimpan untuk pengguna Windows ini."
                                    TextWrapping="Wrap" />
                                <Border
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.BorderInput}"
                                    BorderThickness="{StaticResource Border.Width}"
                                    CornerRadius="{StaticResource Radius.Sm}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            GroupName="AppTheme"
                                            IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                            Content="Gelap"
                                            Style="{StaticResource Segment}" />
                                        <RadioButton
                                            GroupName="AppTheme"
                                            IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                            Content="Terang"
                                            Style="{StaticResource Segment}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    Style="{StaticResource Text.SectionTitle}"
                                    Text="Bahasa &amp; format" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Bahasa" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding LocaleLabel}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Mata uang" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding CurrencyLabel}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Zona waktu" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding Timezone}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Toko" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding ShopName}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Text.Caption}"
                            Text="{Binding AppVersion, StringFormat=POS versi {0}. Perubahan bahasa dan mata uang mengikuti profil toko pada M6.}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Pesanan &amp; pembayaran" Style="{StaticResource TabItem.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border MaxWidth="780" HorizontalAlignment="Left" Style="{StaticResource Card}">
                        <StackPanel>
                            <Border HorizontalAlignment="Left" Style="{StaticResource Badge}">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="S29 · M2" />
                            </Border>
                            <TextBlock
                                Margin="0,14,0,4"
                                Style="{StaticResource Text.SectionTitle}"
                                Text="Perilaku pesanan &amp; pembayaran" />
                            <TextBlock
                                Margin="0,0,0,16"
                                Style="{StaticResource Text.Body}"
                                Text="Pengaturan ini akan tersedia setelah alur kasir dan multi-satuan berjalan."
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Tata letak kasir standar atau visual" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Jumlah dan diskon bawaan" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Izinkan atau blokir stok negatif" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Dialog struk setelah pembayaran" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Alasan void dan jatuh tempo kredit" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Cetak &amp; struk" Style="{StaticResource TabItem.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border MaxWidth="780" HorizontalAlignment="Left" Style="{StaticResource Card}">
                        <StackPanel>
                            <Border HorizontalAlignment="Left" Style="{StaticResource Badge}">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="S30 · M6" />
                            </Border>
                            <TextBlock
                                Margin="0,14,0,4"
                                Style="{StaticResource Text.SectionTitle}"
                                Text="Printer &amp; isi struk" />
                            <TextBlock
                                Margin="0,0,0,16"
                                Style="{StaticResource Text.Body}"
                                Text="Printer ESC/POS, template struk, dan pilihan isi struk akan diatur di sini."
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Pilih printer dan ukuran kertas" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Header, footer, dan logo toko" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Tampilkan satuan jual pada struk" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="• Jumlah item, pajak, dan nomor singkat" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Database" Style="{StaticResource TabItem.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Database lokal" />
                                <TextBlock
                                    Margin="0,4,0,16"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="Data toko disimpan di komputer ini. Cadangan harian dibuat otomatis saat aplikasi dibuka."
                                    TextWrapping="Wrap" />

                                <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="Lokasi database" />
                                <TextBlock
                                    Margin="0,0,0,12"
                                    Style="{StaticResource Text.Mono}"
                                    Text="{Binding DatabasePath}"
                                    TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Versi skema" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding SchemaVersionText}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Ukuran file" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding DatabaseSize}" />
                                </Grid>

                                <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="Folder cadangan" />
                                <TextBlock
                                    Margin="0,0,0,16"
                                    Style="{StaticResource Text.Mono}"
                                    Text="{Binding BackupDirectory}"
                                    TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        Command="{Binding BackupNowCommand}"
                                        Content="Cadangkan sekarang"
                                        IsEnabled="{Binding IsNotBackingUp}"
                                        Style="{StaticResource Button.Primary}" />
                                    <Button
                                        Command="{Binding OpenDataFolderCommand}"
                                        Content="Buka folder data"
                                        Style="{StaticResource Button.Secondary}" />
                                </StackPanel>

                                <TextBlock
                                    Margin="0,12,0,0"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="{Binding BackupMessage}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasBackupMessage, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Pemulihan database" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="Pemulihan dari cadangan akan ditambahkan pada M6 bersama pemeriksaan kesehatan database."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
