<UserControl
    x:Class="Pos.App.Views.PosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding KickCashDrawerCommand}" />
        <KeyBinding Key="F2" Command="{Binding ShowDiscountCommand}" />
        <KeyBinding Key="F3" Command="{Binding OpenSearchModalCommand}" />
        <KeyBinding Key="F4" Command="{Binding ShowQuantityCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenOrdersCommand}" />
        <KeyBinding Key="F8" Command="{Binding NewSaleCommand}" />
        <KeyBinding Key="F9" Command="{Binding SaveSaleCommand}" />
        <KeyBinding Key="F10" Command="{Binding ShowPaymentCommand}" />
        <KeyBinding Key="F12" Command="{Binding ShowPaymentCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDialogsCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Aronium-style action tile: icon on top, label below. -->
        <Style x:Key="PosTile" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PosTile.Danger" TargetType="Button" BasedOn="{StaticResource PosTile}">
            <Setter Property="Background" Value="{DynamicResource Brush.DangerSolid}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerSolidHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnDanger}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSolidHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OnDanger}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PosTile.Success" TargetType="Button" BasedOn="{StaticResource PosTile}">
            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSolid}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessSolidHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSuccess}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSolidHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OnSuccess}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PosSearchInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PosDialog" TargetType="Border" BasedOn="{StaticResource Card.Raised}">
            <Setter Property="Padding" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect" Value="{DynamicResource Effect.Dialog}" />
        </Style>

        <Style x:Key="PosDialogLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="51" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Top Toolbar (51px, #333333) ===================== -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource Brush.Bg}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Menu button -->
                <Button
                    Grid.Column="0"
                    Width="34"
                    Height="34"
                    Margin="6,0,0,0"
                    Command="{Binding OpenMenuCommand}"
                    Content="&#xEA38;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="15"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Menu utama" />

                <!-- Barcode scanner -->
                <Button
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Command="{Binding ShowBarcodeCommand}"
                    Content="&#xEC5A;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="15"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Pindai barcode" />

                <!-- Search mode toggle -->
                <Button
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Command="{Binding ToggleSearchModeCommand}"
                    Content="#"
                    FontFamily="{StaticResource Font.Sans}"
                    FontSize="17"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Cari berdasarkan kode / SKU" />

                <!-- Customer selector -->
                <Button
                    Grid.Column="3"
                    Width="34"
                    Height="34"
                    Command="{Binding ShowCustomerCommand}"
                    Content="&#xE8EC;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="15"
                    Foreground="{DynamicResource Brush.Accent}"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Pilih pelanggan" />

                <!-- Borderless search field -->
                <Grid Grid.Column="4" Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="&#xE721;" />
                    <Grid Grid.Column="1">
                        <TextBox
                            x:Name="ProductSearchBox"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{DynamicResource Brush.Accent}"
                            FontSize="{StaticResource Font.Size.Base}"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            SelectionBrush="{DynamicResource Brush.Accent}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            IsHitTestVisible="False"
                            Text="{Binding SearchHint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- Customer display + clear -->
                <StackPanel
                    Grid.Column="5"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ShowCustomerCommand}"
                        Style="{StaticResource Button.Ghost}"
                        ToolTip="Pilih pelanggan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="&#xE77B;" />
                            <TextBlock
                                Margin="6,0,0,0"
                                MaxWidth="170"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="{Binding CustomerLabel}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding ClearCustomerCommand}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Hapus pelanggan" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Main Content: Cart (637px) + Right Panel (412px) ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="637" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="412" />
            </Grid.ColumnDefinitions>

            <!-- Vertical border between panels -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource Brush.Border}"
                Width="1"
                HorizontalAlignment="Center" />

            <!-- ===================== CART PANEL (637px) ===================== -->
            <Border
                Grid.Column="0"
                Margin="6,0,0,0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Column Headers (40px, #252525, bottom border #1BA1E2) -->
                    <Border
                        Grid.Row="0"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Accent}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="154" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.BodyStrong}"
                                Text="Nama produk" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.BodyStrong}"
                                Text="Qty" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.BodyStrong}"
                                Text="Harga" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.BodyStrong}"
                                Text="Jumlah" />
                        </Grid>
                    </Border>

                    <!-- Scrollable Cart Rows -->
                    <ListBox
                        x:Name="CartList"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Lines}"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                        SelectionMode="Single"
                        Style="{StaticResource ListBox.Plain}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border
                                                    x:Name="Row"
                                                    Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <Rectangle
                                                    x:Name="Separator"
                                                    Height="1"
                                                    Margin="14,0,14,0"
                                                    VerticalAlignment="Bottom"
                                                    Stroke="{DynamicResource Brush.Border}"
                                                    StrokeDashArray="4,4"
                                                    StrokeThickness="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SelectedRow}" />
                                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnSelectedRow}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="47" Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="154" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="15"
                                        Foreground="{DynamicResource Brush.SuccessIcon}"
                                        Text="&#xE72E;" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding SubTitle}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                Foreground="{DynamicResource Brush.Danger}"
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding DiscountDisplay}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                FontStyle="Italic"
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding Comment}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Text.BodyStrong}"
                                        Text="{Binding QuantityDisplay}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{Binding UnitPriceMinor, Converter={StaticResource Currency}}"
                                        Typography.NumeralAlignment="Tabular" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Text="{Binding TotalMinor, Converter={StaticResource Currency}}"
                                        Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty cart message -->
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.TextDisabled}"
                        Style="{StaticResource Text.Body}"
                        Text="Keranjang kosong — cari atau pindai produk untuk mulai."
                        Visibility="{Binding HasNoLines, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Totals Footer (#333333 bg, dashed divider) -->
                    <Border
                        Grid.Row="2"
                        Padding="14,8,14,10"
                        Background="{DynamicResource Brush.Bg}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Labels -->
                            <TextBlock
                                Grid.Row="0" Grid.Column="0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Text.Body}"
                                Text="Subtotal" />
                            <TextBlock
                                Grid.Row="1" Grid.Column="0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Text.Body}"
                                Text="Diskon"
                                Visibility="{Binding HasCartDiscount, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Grid.Row="2" Grid.Column="0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource Text.Body}"
                                Text="Pajak" />
                            <TextBlock
                                Grid.Row="4" Grid.Column="0"
                                HorizontalAlignment="Right"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Text="Total" />

                            <!-- Values -->
                            <TextBlock
                                Grid.Row="0" Grid.Column="1"
                                HorizontalAlignment="Right"
                                MinWidth="180"
                                Text="{Binding Totals.SubtotalMinor, Converter={StaticResource Currency}}"
                                Typography.NumeralAlignment="Tabular" />
                            <TextBlock
                                Grid.Row="1" Grid.Column="1"
                                HorizontalAlignment="Right"
                                MinWidth="180"
                                Foreground="{DynamicResource Brush.Danger}"
                                Text="{Binding Totals.DiscountMinor, Converter={StaticResource Currency}}"
                                Typography.NumeralAlignment="Tabular"
                                Visibility="{Binding HasCartDiscount, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Grid.Row="2" Grid.Column="1"
                                HorizontalAlignment="Right"
                                MinWidth="180"
                                Text="{Binding Totals.TaxMinor, Converter={StaticResource Currency}}"
                                Typography.NumeralAlignment="Tabular" />
                            <TextBlock
                                Grid.Row="4" Grid.Column="1"
                                HorizontalAlignment="Right"
                                MinWidth="180"
                                Style="{StaticResource Text.Total}"
                                Text="{Binding Totals.TotalMinor, Converter={StaticResource Currency}}" />

                            <!-- Dashed divider before Total -->
                            <Rectangle
                                Grid.Row="3" Grid.ColumnSpan="2"
                                Height="1"
                                Margin="0,4,0,6"
                                Stroke="{DynamicResource Brush.Border}"
                                StrokeDashArray="4,4"
                                StrokeThickness="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===================== RIGHT ACTION PANEL (412px) ===================== -->
            <Grid Grid.Column="2" Background="{DynamicResource Brush.Bg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Action Tiles + Payment Types -->
                <Grid Grid.Row="0" Margin="7,0,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="105" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>

                    <!-- 4 Action Tiles: 94px each, 5px gaps, 1px borders -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="94" />
                        </Grid.ColumnDefinitions>

                        <!-- Tile 1: Delete (Red #C62828) -->
                        <Border
                            Grid.Column="0"
                            Margin="0,5,0,5"
                            BorderBrush="{DynamicResource Brush.DangerSolid}"
                            BorderThickness="1"
                            Background="{DynamicResource Brush.DangerSolid}"
                            CornerRadius="0">
                            <Button
                                Command="{Binding RemoveLineCommand}"
                                CommandParameter="{Binding SelectedLine}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource Brush.OnDanger}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="34"
                                        Foreground="{DynamicResource Brush.OnDanger}"
                                        Text="&#xE711;" />
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0"
                                        FontSize="{StaticResource Font.Size.Base}"
                                        Foreground="{DynamicResource Brush.OnDanger}"
                                        Text="Hapus" />
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Tile 2: Search -->
                        <Border
                            Grid.Column="2"
                            Margin="0,5,0,5"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Background="{DynamicResource Brush.Bg}"
                            CornerRadius="0">
                            <Button
                                Command="{Binding OpenSearchModalCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource Brush.Text}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="34"
                                        Foreground="{DynamicResource Brush.Text}"
                                        Text="&#xE721;" />
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0"
                                        FontSize="{StaticResource Font.Size.Base}"
                                        Foreground="{DynamicResource Brush.Text}"
                                        Text="Cari" />
                                    <TextBlock
                                        Margin="8,6,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="{StaticResource Font.Size.Sm}"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Foreground="{DynamicResource Brush.ShortcutGold}"
                                        Text="F3" />
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Tile 3: Quantity -->
                        <Border
                            Grid.Column="4"
                            Margin="0,5,0,5"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Background="{DynamicResource Brush.Bg}"
                            CornerRadius="0">
                            <Button
                                Command="{Binding ShowQuantityCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource Brush.Text}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid
                                        Grid.Row="0"
                                        Width="36"
                                        Height="34"
                                        HorizontalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="30"
                                            Foreground="{DynamicResource Brush.Text}"
                                            Text="&#xE7BF;" />
                                        <Border
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.Text}"
                                            CornerRadius="7">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Sans}"
                                                FontSize="11"
                                                FontWeight="{StaticResource Font.Weight.Bold}"
                                                Foreground="{DynamicResource Brush.Bg}"
                                                Text="+" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0"
                                        FontSize="{StaticResource Font.Size.Base}"
                                        Foreground="{DynamicResource Brush.Text}"
                                        Text="Jumlah" />
                                    <TextBlock
                                        Margin="8,6,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="{StaticResource Font.Size.Sm}"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Foreground="{DynamicResource Brush.ShortcutBlue}"
                                        Text="F4" />
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Tile 4: New Sale -->
                        <Border
                            Grid.Column="6"
                            Margin="0,5,0,5"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Background="{DynamicResource Brush.Bg}"
                            CornerRadius="0">
                            <Button
                                Command="{Binding NewSaleCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource Brush.Text}"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="34"
                                        Foreground="{DynamicResource Brush.Text}"
                                        Text="&#xE710;" />
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0"
                                        FontSize="{StaticResource Font.Size.Base}"
                                        Foreground="{DynamicResource Brush.Text}"
                                        Text="Baru" />
                                    <TextBlock
                                        Margin="8,6,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="{StaticResource Font.Size.Sm}"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Foreground="{DynamicResource Brush.ShortcutBlue}"
                                        Text="F8" />
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>

                    <!-- Payment Type Row (26px, #252525 bg) -->
                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1,0,1,0">
                        <ItemsControl ItemsSource="{Binding PaymentTypes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                                        <Border BorderThickness="0,0,0,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MarkAsPaid}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessSolid}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button
                                                Height="23"
                                                Background="{DynamicResource Brush.Surface}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ChoosePaymentTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource Brush.Text}"
                                                Style="{StaticResource Button.Ghost}"
                                                VerticalContentAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource Font.Size.Sm}"
                                                    Foreground="{DynamicResource Brush.Text}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Payment Selection Indicator (3px) -->
                    <Border
                        Grid.Row="2"
                        Height="3"
                        Background="{DynamicResource Brush.Accent}"
                        BorderThickness="0" />
                </Grid>

                <!-- Empty Middle: Watermark -->
                <Grid Grid.Row="1">
                    <StackPanel
                        Margin="0,33,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                        <!-- Hexagon "a" -->
                        <Grid
                            Width="116"
                            Height="97"
                            HorizontalAlignment="Center">
                            <Path
                                Data="M 33,4 L 82,4 L 111,48 L 82,92 L 33,92 L 4,48 Z"
                                Stroke="{DynamicResource Brush.Watermark}"
                                StrokeThickness="7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="88"
                                FontWeight="{StaticResource Font.Weight.Regular}"
                                Foreground="{DynamicResource Brush.Watermark}"
                                Text="a" />
                        </Grid>
                        <TextBlock
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            FontSize="52"
                            FontWeight="{StaticResource Font.Weight.Regular}"
                            Foreground="{DynamicResource Brush.Watermark}"
                            Text="aroklon" />
                    </StackPanel>

                    <StackPanel
                        Margin="12,0,12,12"
                        VerticalAlignment="Bottom">
                        <TextBlock
                            Style="{StaticResource Text.Caption}"
                            Text="{Binding ParkedSaleLabel, StringFormat='Pesanan aktif: {0}'}"
                            Visibility="{Binding ParkedSaleLabel, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Error}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Secondary}"
                            Text="{Binding InfoMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- Bottom Action Grid: 3 rows -->
                <Grid Grid.Row="2" Margin="7,0,5,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="84" />
                        <RowDefinition Height="84" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="94" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="94" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="94" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 1: Discount, Comment, Cash Drawer (spans 2) -->
                    <Border
                        Grid.Row="0" Grid.Column="0"
                        Margin="0,0,0,6"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding ShowDiscountCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="38"
                                    FontWeight="{StaticResource Font.Weight.Bold}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="%" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Diskon" />
                                <TextBlock
                                    Margin="8,6,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource Font.Size.Sm}"
                                    FontWeight="{StaticResource Font.Weight.SemiBold}"
                                    Foreground="{DynamicResource Brush.ShortcutGold}"
                                    Text="F2" />
                            </Grid>
                        </Button>
                    </Border>

                    <Border
                        Grid.Row="0" Grid.Column="2"
                        Margin="0,0,0,6"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding ShowCommentCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="30"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE90A;" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Komentar" />
                            </Grid>
                        </Button>
                    </Border>

                    <Border
                        Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3"
                        Margin="0,0,0,6"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding KickCashDrawerCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="30"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xEC59;" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Laci kas" />
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Row 2: Save, Refund, Payment (green, spans 2) -->
                    <Border
                        Grid.Row="1" Grid.Column="0"
                        Margin="0,0,0,6"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding SaveSaleCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="38"
                                    FontWeight="{StaticResource Font.Weight.Bold}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="F9" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Simpan" />
                                <Border
                                    Margin="0,4,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.DangerSolid}"
                                    CornerRadius="12"
                                    MinWidth="24"
                                    Padding="6,1"
                                    Visibility="{Binding HasParkedOrders, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource Font.Size.Sm}"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Foreground="{DynamicResource Brush.OnDanger}"
                                        Text="{Binding ParkedOrderCount}" />
                                </Border>
                            </Grid>
                        </Button>
                    </Border>

                    <Border
                        Grid.Row="1" Grid.Column="2"
                        Margin="0,0,0,6"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding OpenRefundCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="30"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE7A7;" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Refund" />
                            </Grid>
                        </Button>
                    </Border>

                    <Border
                        Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3"
                        Margin="0,0,0,6"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.SuccessSolid}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding ShowPaymentCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.OnSuccess}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontSize="38"
                                    FontWeight="{StaticResource Font.Weight.Bold}"
                                    Foreground="{DynamicResource Brush.OnSuccess}"
                                    Text="F10" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.OnSuccess}"
                                    Text="Pembayaran" />
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Row 3: Lock, Transfer, Void (red), More -->
                    <Border
                        Grid.Row="2" Grid.Column="0"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding LockScreenCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="30"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE72E;" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Kunci" />
                            </Grid>
                        </Button>
                    </Border>

                    <Border
                        Grid.Row="2" Grid.Column="2"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding OpenOrdersCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="30"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE81E;" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="Transfer" />
                                <TextBlock
                                    Margin="8,6,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource Font.Size.Sm}"
                                    FontWeight="{StaticResource Font.Weight.SemiBold}"
                                    Foreground="{DynamicResource Brush.ShortcutBlue}"
                                    Text="F7" />
                            </Grid>
                        </Button>
                    </Border>

                    <Border
                        Grid.Row="2" Grid.Column="4"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.DangerSolid}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding ShowVoidConfirmCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.OnDanger}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="30"
                                    Foreground="{DynamicResource Brush.OnDanger}"
                                    Text="&#xE74D;" />
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    FontSize="{StaticResource Font.Size.Base}"
                                    Foreground="{DynamicResource Brush.OnDanger}"
                                    Text="Void" />
                            </Grid>
                        </Button>
                    </Border>

                    <Border
                        Grid.Row="2" Grid.Column="6"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Bg}"
                        CornerRadius="0">
                        <Button
                            Command="{Binding OpenMenuCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource Brush.Text}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="&#xE712;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="26"
                            ToolTip="Menu utama" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Dialogs (all at main Grid level) ===================== -->
        <!-- Search results dropdown -->
        <Border
            Grid.Row="1"
            Width="520"
            Margin="216,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="20"
            Background="{DynamicResource Brush.SurfaceRaised}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Sm}"
            Visibility="{Binding IsSearchResultsOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="8,4"
                                    Padding="12,8"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource Button.Ghost}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="16"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Text="&#xE7BF;" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock
                                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Style="{StaticResource Text.Caption}"
                                                Text="{Binding SubTitle}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                                            Text="{Binding PriceMinor, Converter={StaticResource Currency}}"
                                            Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Quantity -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="40"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsQuantityVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="390" Style="{StaticResource PosDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Jumlah" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.BodyStrong}" Text="Qty" />
                        <TextBox
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Style="{StaticResource Input}"
                            Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmQuantityCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Margin="0,0,8,0"
                            Command="{Binding ConfirmQuantityCommand}"
                            Content="OK"
                            IsDefault="True"
                            Style="{StaticResource Button.Primary}" />
                        <Button
                            Width="100"
                            Command="{Binding HideQuantityCommand}"
                            Content="Batal"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Discount -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="41"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsDiscountVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="420" Style="{StaticResource PosDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Diskon" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.BodyStrong}" Text="%" />
                        <TextBox
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Style="{StaticResource Input}"
                            Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyDiscountCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding DiscountError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding DiscountError, Converter={StaticResource StringToVisibility}}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Margin="0,0,8,0"
                            Command="{Binding ApplyDiscountCommand}"
                            Content="Terapkan"
                            Style="{StaticResource Button.Primary}" />
                        <Button
                            Width="100"
                            Command="{Binding HideDiscountCommand}"
                            Content="Batal"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Comment -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="42"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsCommentVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="420" Style="{StaticResource PosDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Komentar" />
                    <TextBox
                        Margin="0,12,0,0"
                        Height="90"
                        AcceptsReturn="True"
                        Style="{StaticResource Input}"
                        Text="{Binding CommentInput, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Margin="0,0,8,0"
                            Command="{Binding ApplyCommentCommand}"
                            Content="OK"
                            Style="{StaticResource Button.Primary}" />
                        <Button
                            Width="100"
                            Command="{Binding HideCommentCommand}"
                            Content="Batal"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Payment -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="43"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsPaymentVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="480" Style="{StaticResource PosDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Pembayaran" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding PaymentSummary}" />
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding PaymentTypeItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4,0,0" Padding="12,8" Background="{DynamicResource Brush.Surface}" CornerRadius="{StaticResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="18"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Text="{Binding Icon}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="{StaticResource Font.Weight.SemiBold}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Shortcut}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            Padding="16,4"
                                            Command="{Binding DataContext.SelectPaymentTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Primary}"
                                            Content="Pilih" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding PaymentError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding PaymentError, Converter={StaticResource StringToVisibility}}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.BodyStrong}" Text="Total: " />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Total}" Text="{Binding TotalText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Width="120"
                                Margin="0,0,8,0"
                                Command="{Binding ApplyPaymentCommand}"
                                Content="Bayar"
                                IsDefault="True"
                                Style="{StaticResource Button.Primary}" />
                            <Button
                                Width="100"
                                Command="{Binding HidePaymentCommand}"
                                Content="Batal"
                                Style="{StaticResource Button.Secondary}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Barcode -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="44"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsBarcodeVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="420" Style="{StaticResource PosDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Pindai barcode" />
                    <TextBlock
                        Margin="0,4,0,10"
                        Style="{StaticResource Text.Secondary}"
                        Text="Scan barcode atau ketik kodenya, lalu tekan Enter." />
                    <TextBox
                        x:Name="BarcodeBox"
                        IsVisibleChanged="OnBarcodeBoxVisibleChanged"
                        Style="{StaticResource Input}"
                        Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ScanBarcodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="110"
                            Margin="0,0,8,0"
                            Command="{Binding ScanBarcodeCommand}"
                            Content="Scan"
                            IsDefault="True"
                            Style="{StaticResource Button.Primary}" />
                        <Button
                            Width="100"
                            Command="{Binding HideBarcodeCommand}"
                            Content="Batal"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Price override -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="45"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsPriceOverrideVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="400" Style="{StaticResource PosDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Harga manual" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.BodyStrong}" Text="Harga" />
                        <TextBox
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Style="{StaticResource Input}"
                            Text="{Binding PriceOverrideInput, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyPriceOverrideCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Margin="0,0,8,0"
                            Command="{Binding ApplyPriceOverrideCommand}"
                            Content="OK"
                            IsDefault="True"
                            Style="{StaticResource Button.Primary}" />
                        <Button
                            Width="100"
                            Command="{Binding HidePriceOverrideCommand}"
                            Content="Batal"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Void confirmation -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="46"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsVoidConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="400" Style="{StaticResource PosDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DialogTitle}" Foreground="{DynamicResource Brush.Danger}" Text="Batalkan transaksi?" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="Semua item di keranjang akan dihapus. Lanjutkan?" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Margin="0,0,8,0"
                            Command="{Binding ConfirmVoidCommand}"
                            Content="Ya, batalkan"
                            Style="{StaticResource Button.Danger}" />
                        <Button
                            Width="100"
                            Command="{Binding HideVoidConfirmCommand}"
                            Content="Tidak"
                            Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Customer selection -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="48"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsCustomerVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="520" Style="{StaticResource PosDialog}">
                <ContentControl Content="{Binding CustomerSelectionVm}" />
            </Border>
        </Border>

        <!-- Advanced product search (F3) -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="47"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsSearchModalOpen, Converter={StaticResource BoolToVisibility}}">
            <Border
                Width="760"
                Height="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Bg}"
                BorderBrush="{DynamicResource Brush.BorderInput}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Sm}">
                <ContentControl Content="{Binding ProductSearchVm}" />
            </Border>
        </Border>
    </Grid>
</UserControl>