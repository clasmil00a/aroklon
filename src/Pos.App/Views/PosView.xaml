<UserControl
    x:Class="Pos.App.Views.PosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding KickCashDrawerCommand}" />
        <KeyBinding Key="F2" Command="{Binding ShowDiscountCommand}" />
        <KeyBinding Key="F3" Command="{Binding OpenSearchModalCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding CycleSearchModeCommand}" />
        <KeyBinding Key="F4" Command="{Binding ShowQuantityCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenOrdersCommand}" />
        <KeyBinding Key="F8" Command="{Binding NewSaleCommand}" />
        <KeyBinding Key="F9" Command="{Binding SaveSaleCommand}" />
        <KeyBinding Key="F10" Command="{Binding ShowPaymentCommand}" />
        <KeyBinding Key="F12" Command="{Binding ShowPaymentCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDialogsCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Flat Aronium action tile: white icon above a 13 px caption. -->
        <Style x:Key="PosActionTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosTileLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Regular}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PosShortcut" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8,5,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.ShortcutGold}" />
        </Style>

        <Style x:Key="PaymentTypeCell" TargetType="Button">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="DialogShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect" Value="{DynamicResource Effect.Dialog}" />
        </Style>

        <Style x:Key="DialogClose" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <Style x:Key="DialogField" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
        </Style>

        <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
        </Style>

        <Style x:Key="PaymentActionButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Width" Value="184" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="PaymentTypeChoice" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Width" Value="166" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PaymentPaidInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Width" Value="204" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentActive}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="PaymentTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="LineHeight" Value="26" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Light}" />
        </Style>

        <Style x:Key="PaymentValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="51" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== POS toolbar ===================== -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource Brush.Bg}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Aronium search switcher: all fields / barcode / code / name.
                     The active option turns accent cyan, as in the reference. -->
                <Button
                    Grid.Column="0"
                    Width="34"
                    Height="34"
                    Margin="6,0,0,0"
                    Command="{Binding SetSearchModeCommand}"
                    CommandParameter="all"
                    ToolTip="Cari semua kolom (nama, kode, barcode)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchMode}" Value="all">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="22" Height="22">
                        <Path
                            Data="M 12,2 L 12,22 M 2,12 L 22,12 M 4.9,4.9 L 19.1,19.1 M 19.1,4.9 L 4.9,19.1"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.8" />
                    </Viewbox>
                </Button>

                <!-- Search option: barcode -->
                <Button
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Command="{Binding SetSearchModeCommand}"
                    CommandParameter="barcode"
                    Content="&#xEC5A;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="17"
                    ToolTip="Cari barcode">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchMode}" Value="barcode">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Search option: code / SKU -->
                <Button
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Command="{Binding SetSearchModeCommand}"
                    CommandParameter="code"
                    Content="#"
                    FontFamily="{StaticResource Font.Sans}"
                    FontSize="20"
                    FontWeight="{StaticResource Font.Weight.SemiBold}"
                    ToolTip="Cari kode / SKU">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchMode}" Value="code">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Search option: name (default, accent cyan) -->
                <Button
                    Grid.Column="3"
                    Width="34"
                    Height="34"
                    Command="{Binding SetSearchModeCommand}"
                    CommandParameter="name"
                    Content="&#xE8EC;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="17"
                    ToolTip="Cari nama produk">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchMode}" Value="name">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Borderless search field -->
                <Grid Grid.Column="4" Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="&#xE721;" />
                    <Grid Grid.Column="1">
                        <TextBox
                            x:Name="ProductSearchBox"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{DynamicResource Brush.Accent}"
                            FontSize="{StaticResource Font.Size.Base}"
                            Foreground="{DynamicResource Brush.Text}"
                            Height="34"
                            Padding="0"
                            SelectionBrush="{DynamicResource Brush.Accent}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            IsHitTestVisible="False"
                            Text="{Binding SearchHint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Cart + action panel ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="412" />
            </Grid.ColumnDefinitions>

            <!-- CART -->
            <Border
                Grid.Column="0"
                Margin="5,0,0,5"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1,0,1,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="114" />
                    </Grid.RowDefinitions>

                    <!-- Cart header -->
                    <Border
                        Grid.Row="0"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Accent}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="148" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Nama produk" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Jumlah" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Harga" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Total" />
                        </Grid>
                    </Border>

                    <!-- Cart rows -->
                    <ListBox
                        x:Name="CartList"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Lines}"
                        MouseDoubleClick="OnCartRowDoubleClick"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                        SelectionMode="Single"
                        Style="{StaticResource ListBox.Plain}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="Row" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <Rectangle
                                                    x:Name="Separator"
                                                    Height="1"
                                                    Margin="6,0,6,0"
                                                    VerticalAlignment="Bottom"
                                                    Stroke="{DynamicResource Brush.Border}"
                                                    StrokeDashArray="4,4"
                                                    StrokeThickness="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SelectedRow}" />
                                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnSelectedRow}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="47" Margin="8,0,18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="148" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.SuccessIcon}"
                                        Text="&#xE72E;" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,3,8,3">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                Opacity="0.72"
                                                Text="{Binding SubTitle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource Brush.Danger}"
                                                Text="{Binding DiscountDisplay}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                FontSize="11"
                                                FontStyle="Italic"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                Opacity="0.85"
                                                Text="{Binding Comment}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Text="{Binding QuantityDisplay}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Text="{Binding UnitPriceMinor, Converter={StaticResource Currency}}"
                                        Typography.NumeralAlignment="Tabular" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Text="{Binding TotalMinor, Converter={StaticResource Currency}}"
                                        Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource Brush.TextDisabled}"
                        Text="Keranjang kosong — cari atau pindai produk untuk mulai."
                        Visibility="{Binding HasNoLines, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Totals footer -->
                    <Border
                        Grid.Row="2"
                        Background="{DynamicResource Brush.Bg}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                        <Grid Margin="0,6,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0" Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Subtotal" />
                            <TextBlock
                                Grid.Row="0" Grid.Column="1"
                                MinWidth="130"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="{Binding Totals.SubtotalMinor, Converter={StaticResource Currency}}"
                                Typography.NumeralAlignment="Tabular" />

                            <TextBlock
                                Grid.Row="1" Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Diskon"
                                Visibility="{Binding HasCartDiscount, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Grid.Row="1" Grid.Column="1"
                                MinWidth="130"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Danger}"
                                Text="{Binding Totals.DiscountMinor, Converter={StaticResource Currency}}"
                                Typography.NumeralAlignment="Tabular"
                                Visibility="{Binding HasCartDiscount, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                Grid.Row="2" Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Pajak" />
                            <TextBlock
                                Grid.Row="2" Grid.Column="1"
                                MinWidth="130"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="{Binding Totals.TaxMinor, Converter={StaticResource Currency}}"
                                Typography.NumeralAlignment="Tabular" />

                            <Rectangle
                                Grid.Row="3" Grid.ColumnSpan="2"
                                Height="1"
                                Margin="34,4,0,4"
                                Stroke="{DynamicResource Brush.Border}"
                                StrokeDashArray="4,4"
                                StrokeThickness="1" />

                            <TextBlock
                                Grid.Row="4" Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="{StaticResource Font.Weight.Bold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="Total" />
                            <TextBlock
                                Grid.Row="4" Grid.Column="1"
                                MinWidth="130"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="26"
                                FontWeight="{StaticResource Font.Weight.Bold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="{Binding TotalText}"
                                Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT ACTION PANEL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>

                <!-- Top action tiles -->
                <Grid Grid.Row="1" Margin="7,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Delete -->
                    <Button
                        Grid.Column="0"
                        Background="{DynamicResource Brush.DangerSolid}"
                        BorderBrush="{DynamicResource Brush.DangerSolid}"
                        Command="{Binding RemoveLineCommand}"
                        CommandParameter="{Binding SelectedLine}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Hapus baris terpilih">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="34"
                                Foreground="{DynamicResource Brush.OnDanger}"
                                Text="&#xE711;" />
                            <TextBlock
                                Style="{StaticResource PosTileLabel}"
                                Foreground="{DynamicResource Brush.OnDanger}"
                                Text="Hapus" />
                        </Grid>
                    </Button>

                    <!-- Search -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding OpenSearchModalCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Cari produk (F3)">
                        <Grid>
                            <TextBlock Style="{StaticResource PosShortcut}" Text="F3" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="32"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="&#xE721;" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Cari" />
                        </Grid>
                    </Button>

                    <!-- Quantity -->
                    <Button
                        Grid.Column="4"
                        Command="{Binding ShowQuantityCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Ubah jumlah (F4)">
                        <Grid>
                            <TextBlock Style="{StaticResource PosShortcut}" Text="F4" />
                            <Grid
                                Width="38"
                                Height="36"
                                Margin="0,0,0,18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="30"
                                    Foreground="{DynamicResource Brush.Text}"
                                    Text="&#xE7BF;" />
                                <Border
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,-2,-2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.Text}"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="{StaticResource Font.Weight.Bold}"
                                        Foreground="{DynamicResource Brush.Bg}"
                                        Text="+" />
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Jumlah" />
                        </Grid>
                    </Button>

                    <!-- New sale -->
                    <Button
                        Grid.Column="6"
                        Command="{Binding NewSaleCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Penjualan baru (F8)">
                        <Grid>
                            <TextBlock Style="{StaticResource PosShortcut}" Text="F8" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="34"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="&#xE710;" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Baru" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Payment type strip -->
                <ItemsControl Grid.Row="3" Margin="7,0,1,0" ItemsSource="{Binding PaymentTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding DataContext.ChoosePaymentTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource PaymentTypeCell}">
                                <Grid>
                                    <TextBlock
                                        Margin="9,5,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="11"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Foreground="{DynamicResource Brush.TextMuted}"
                                        Text="{Binding Shortcut}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,8,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.Text}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Height="3"
                                        VerticalAlignment="Bottom">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MarkAsPaid}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSolid}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Watermark + messages -->
                <Grid Grid.Row="4">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Opacity="0.9">
                        <Image
                            Width="100"
                            Height="100"
                            HorizontalAlignment="Center"
                            Source="/Aroklon;component/Resources/logo-ak-mono.png" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource Font.Sans}"
                            FontSize="48"
                            FontWeight="{StaticResource Font.Weight.Light}"
                            Foreground="{DynamicResource Brush.Watermark}"
                            Text="aroklon" />
                    </StackPanel>

                    <StackPanel
                        Margin="12,0,12,10"
                        VerticalAlignment="Bottom">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="{Binding ParkedSaleLabel, StringFormat='Pesanan aktif: {0}'}"
                            Visibility="{Binding ParkedSaleLabel, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.Danger}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="{Binding InfoMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- Bottom action tiles -->
                <Grid Grid.Row="5" Margin="7,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Discount -->
                    <Button
                        Grid.Column="0"
                        Command="{Binding ShowDiscountCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Diskon (F2)">
                        <Grid>
                            <TextBlock Style="{StaticResource PosShortcut}" Text="F2" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontSize="34"
                                FontWeight="{StaticResource Font.Weight.Light}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="%" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Diskon" />
                        </Grid>
                    </Button>

                    <!-- Comment -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding ShowCommentCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Komentar baris">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="&#xE90A;" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Komentar" />
                        </Grid>
                    </Button>

                    <!-- Cash drawer -->
                    <Button
                        Grid.Column="4"
                        Grid.ColumnSpan="3"
                        Command="{Binding KickCashDrawerCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Buka laci kas (Ctrl+D)">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="&#xEC59;" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Laci kas" />
                        </Grid>
                    </Button>
                </Grid>

                <Grid Grid.Row="7" Margin="7,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Save sale -->
                    <Button
                        Grid.Column="0"
                        Command="{Binding SaveSaleCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Simpan pesanan (F9)">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontSize="28"
                                FontWeight="{StaticResource Font.Weight.Bold}"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="F9" />
                            <Border
                                MinWidth="20"
                                Height="20"
                                Margin="0,6,10,0"
                                Padding="4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.DangerSolid}"
                                CornerRadius="10"
                                Visibility="{Binding HasParkedOrders, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="{StaticResource Font.Weight.SemiBold}"
                                    Foreground="{DynamicResource Brush.OnDanger}"
                                    Text="{Binding ParkedOrderCount}" />
                            </Border>
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Simpan" />
                        </Grid>
                    </Button>

                    <!-- Refund -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding OpenRefundCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Refund">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="&#xE7A7;" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Refund" />
                        </Grid>
                    </Button>

                    <!-- Payment -->
                    <Button
                        Grid.Column="4"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Brush.SuccessSolid}"
                        BorderBrush="{DynamicResource Brush.SuccessSolid}"
                        Command="{Binding ShowPaymentCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Pembayaran (F10)">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontSize="28"
                                FontWeight="{StaticResource Font.Weight.Bold}"
                                Foreground="{DynamicResource Brush.OnSuccess}"
                                Text="F10" />
                            <TextBlock
                                Style="{StaticResource PosTileLabel}"
                                Foreground="{DynamicResource Brush.OnSuccess}"
                                Text="Pembayaran" />
                        </Grid>
                    </Button>
                </Grid>

                <Grid Grid.Row="9" Margin="7,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Lock -->
                    <Button
                        Grid.Column="0"
                        Command="{Binding LockScreenCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Kunci layar">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="26"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="&#xE72E;" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Kunci" />
                        </Grid>
                    </Button>

                    <!-- Transfer / open orders -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding OpenOrdersCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Pesanan terbuka (F7)">
                        <Grid>
                            <TextBlock Style="{StaticResource PosShortcut}" Text="F7" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="26"
                                Foreground="{DynamicResource Brush.Text}"
                                Text="&#xE81E;" />
                            <TextBlock Style="{StaticResource PosTileLabel}" Text="Transfer" />
                        </Grid>
                    </Button>

                    <!-- Void -->
                    <Button
                        Grid.Column="4"
                        Background="{DynamicResource Brush.DangerSolid}"
                        BorderBrush="{DynamicResource Brush.DangerSolid}"
                        Command="{Binding ShowVoidConfirmCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Batalkan transaksi">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="26"
                                Foreground="{DynamicResource Brush.OnDanger}"
                                Text="&#xE74D;" />
                            <TextBlock
                                Style="{StaticResource PosTileLabel}"
                                Foreground="{DynamicResource Brush.OnDanger}"
                                Text="Void" />
                        </Grid>
                    </Button>

                    <!-- More -->
                    <Button
                        Grid.Column="6"
                        Command="{Binding OpenMenuCommand}"
                        Style="{StaticResource PosActionTile}"
                        ToolTip="Menu utama">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="26"
                            Foreground="{DynamicResource Brush.Text}"
                            Text="&#xE712;" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- Search results dropdown, aligned under the search field -->
        <Border
            Grid.Row="1"
            Width="520"
            Margin="174,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="20"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Visibility="{Binding IsSearchResultsOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0"
                                Padding="12,7"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource Button.Ghost}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="15"
                                        Foreground="{DynamicResource Brush.SuccessIcon}"
                                        Text="&#xE7BF;" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="{StaticResource Font.Weight.SemiBold}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            Text="{Binding SubTitle}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                        Text="{Binding PriceMinor, Converter={StaticResource Currency}}"
                                        Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ===================== Quantity dialog ===================== -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="44"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsQuantityVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="380" Style="{StaticResource DialogShell}">
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Jumlah" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{Binding HideQuantityCommand}"
                            Content="&#xE711;"
                            Style="{StaticResource DialogClose}" />
                    </Grid>
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                        Text="{Binding QuantityLineName}" />
                    <TextBlock
                        Margin="0,2,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="{Binding QuantityUnitLabel}" />
                    <TextBox
                        x:Name="QuantityBox"
                        Height="52"
                        FontSize="28"
                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                        IsVisibleChanged="OnDialogTextBoxVisibleChanged"
                        Style="{StaticResource DialogField}"
                        Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Right">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyQuantityCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding QuantityError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding QuantityError, Converter={StaticResource StringToVisibility}}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Click="OnKeypadDigitClick" Content="1" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="0" Grid.Column="1" Click="OnKeypadDigitClick" Content="2" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="0" Grid.Column="2" Click="OnKeypadDigitClick" Content="3" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="0" Grid.Column="3" Click="OnKeypadDigitClick" Content="&#x232B;" FontFamily="{StaticResource Font.Sans}" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="1" Grid.Column="0" Click="OnKeypadDigitClick" Content="4" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="1" Grid.Column="1" Click="OnKeypadDigitClick" Content="5" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="1" Grid.Column="2" Click="OnKeypadDigitClick" Content="6" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="1" Grid.Column="3" Command="{Binding HideQuantityCommand}" Content="esc" FontSize="13" Style="{StaticResource KeypadButton}" />
                        <Button Grid.Row="2" Grid.Column="0" Click="OnKeypadDigitClick" Content="7" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="2" Grid.Column="1" Click="OnKeypadDigitClick" Content="8" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="2" Grid.Column="2" Click="OnKeypadDigitClick" Content="9" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button
                            Grid.Row="2" Grid.Column="3" Grid.RowSpan="2"
                            Background="{DynamicResource Brush.Accent}"
                            BorderBrush="{DynamicResource Brush.Accent}"
                            Command="{Binding ApplyQuantityCommand}"
                            Content="&#x2190;"
                            Foreground="{DynamicResource Brush.OnAccent}"
                            Style="{StaticResource KeypadButton}" />
                        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Click="OnKeypadDigitClick" Content="0" Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                        <Button Grid.Row="3" Grid.Column="2" Click="OnKeypadDigitClick" Content="." Style="{StaticResource KeypadButton}" Tag="QuantityBox" />
                    </Grid>

                    <StackPanel
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding HideQuantityCommand}"
                            Content="Batal"
                            Style="{StaticResource DialogSecondaryButton}" />
                        <Button
                            Command="{Binding ApplyQuantityCommand}"
                            Content="Terapkan"
                            Style="{StaticResource DialogPrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Discount dialog ===================== -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="55"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsDiscountVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="400" Style="{StaticResource DialogShell}">
                <StackPanel>
                    <!-- Tabs -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="44"
                            Background="{DynamicResource Brush.Bg}"
                            Command="{Binding SetCartDiscountTargetCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DiscountIsLine}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiscountIsLine}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Diskon transaksi" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            Height="44"
                            Background="{DynamicResource Brush.Bg}"
                            Command="{Binding SetLineDiscountTargetCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DiscountIsLine}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DiscountIsLine}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Diskon item" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" />

                    <StackPanel Margin="20,14,20,16">
                        <Grid>
                            <TextBlock Style="{StaticResource Text.DialogTitle}" Text="{Binding DiscountTitle}" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{Binding HideDiscountCommand}"
                                Content="&#xE711;"
                                Style="{StaticResource DialogClose}" />
                        </Grid>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="{Binding DiscountTargetLabel}" />

                        <!-- Percent / amount toggle -->
                        <StackPanel
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Width="52"
                                Height="30"
                                Command="{Binding UsePercentDiscountCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                                        <Setter Property="Height" Value="30" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscountUseAmount}" Value="True">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="%" />
                            </Button>
                            <Button
                                Width="52"
                                Height="30"
                                Margin="4,0,0,0"
                                Command="{Binding UseAmountDiscountCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                                        <Setter Property="Height" Value="30" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscountUseAmount}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Rp" />
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="Diskon" />

                        <Grid Margin="30,0,30,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="DiscountBox"
                                Grid.Column="0"
                                Height="48"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1"
                                FontSize="30"
                                FontWeight="{StaticResource Font.Weight.SemiBold}"
                                IsVisibleChanged="OnDialogTextBoxVisibleChanged"
                                Style="{StaticResource Input}"
                                Text="{Binding DiscountValueText, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Right">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyDiscountCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="%">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscountUseAmount}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="Rp">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscountUseAmount}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource Text.Error}"
                            Text="{Binding DiscountError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding DiscountError, Converter={StaticResource StringToVisibility}}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Click="OnKeypadDigitClick" Content="1" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="0" Grid.Column="1" Click="OnKeypadDigitClick" Content="2" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="0" Grid.Column="2" Click="OnKeypadDigitClick" Content="3" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="0" Grid.Column="3" Click="OnKeypadDigitClick" Content="&#x232B;" FontFamily="{StaticResource Font.Sans}" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="1" Grid.Column="0" Click="OnKeypadDigitClick" Content="4" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="1" Grid.Column="1" Click="OnKeypadDigitClick" Content="5" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="1" Grid.Column="2" Click="OnKeypadDigitClick" Content="6" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="1" Grid.Column="3" Command="{Binding HideDiscountCommand}" Content="esc" FontSize="13" Style="{StaticResource KeypadButton}" />
                            <Button Grid.Row="2" Grid.Column="0" Click="OnKeypadDigitClick" Content="7" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="2" Grid.Column="1" Click="OnKeypadDigitClick" Content="8" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="2" Grid.Column="2" Click="OnKeypadDigitClick" Content="9" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button
                                Grid.Row="2" Grid.Column="3" Grid.RowSpan="2"
                                Background="{DynamicResource Brush.Accent}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                Command="{Binding ApplyDiscountCommand}"
                                Content="&#x2190;"
                                Foreground="{DynamicResource Brush.OnAccent}"
                                Style="{StaticResource KeypadButton}" />
                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Click="OnKeypadDigitClick" Content="0" Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                            <Button Grid.Row="3" Grid.Column="2" Click="OnKeypadDigitClick" Content="." Style="{StaticResource KeypadButton}" Tag="DiscountBox" />
                        </Grid>

                        <Border
                            Margin="0,10,0,0"
                            Padding="0,8,0,0"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0">
                            <Button
                                HorizontalAlignment="Center"
                                Command="{Binding ClearDiscountCommand}"
                                Style="{StaticResource Button.Ghost}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE74D;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="Hapus diskon" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Comment dialog ===================== -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="45"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsCommentVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="440" Style="{StaticResource DialogShell}">
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Komentar" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{Binding HideCommentCommand}"
                            Content="&#xE711;"
                            Style="{StaticResource DialogClose}" />
                    </Grid>
                    <TextBlock
                        Margin="0,4,0,10"
                        FontSize="11"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Komentar untuk baris keranjang terpilih." />
                    <TextBox
                        Height="100"
                        AcceptsReturn="True"
                        Style="{StaticResource Input.Multiline}"
                        Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding HideCommentCommand}"
                            Content="Batal"
                            Style="{StaticResource DialogSecondaryButton}" />
                        <Button
                            Command="{Binding ApplyCommentCommand}"
                            Content="Simpan"
                            Style="{StaticResource DialogPrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Price override dialog ===================== -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="46"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsPriceOverrideVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="380" Style="{StaticResource DialogShell}">
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Harga manual" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{Binding HidePriceOverrideCommand}"
                            Content="&#xE711;"
                            Style="{StaticResource DialogClose}" />
                    </Grid>
                    <TextBlock
                        Margin="0,4,0,2"
                        FontSize="12"
                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                        Text="{Binding SelectedLine.Name}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="11"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Masukkan harga satuan baru." />
                    <TextBox
                        x:Name="PriceBox"
                        Height="52"
                        FontSize="28"
                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                        IsVisibleChanged="OnDialogTextBoxVisibleChanged"
                        Style="{StaticResource DialogField}"
                        Text="{Binding PriceOverrideText, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Right">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyPriceOverrideCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding PriceOverrideError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding PriceOverrideError, Converter={StaticResource StringToVisibility}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Click="OnKeypadDigitClick" Content="1" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="0" Grid.Column="1" Click="OnKeypadDigitClick" Content="2" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="0" Grid.Column="2" Click="OnKeypadDigitClick" Content="3" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="1" Grid.Column="0" Click="OnKeypadDigitClick" Content="4" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="1" Grid.Column="1" Click="OnKeypadDigitClick" Content="5" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="1" Grid.Column="2" Click="OnKeypadDigitClick" Content="6" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="2" Grid.Column="0" Click="OnKeypadDigitClick" Content="7" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="2" Grid.Column="1" Click="OnKeypadDigitClick" Content="8" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="2" Grid.Column="2" Click="OnKeypadDigitClick" Content="9" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="3" Grid.Column="0" Click="OnKeypadDigitClick" Content="0" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="3" Grid.Column="1" Click="OnKeypadDigitClick" Content="&#x232B;" FontFamily="{StaticResource Font.Sans}" Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                        <Button Grid.Row="3" Grid.Column="2" Click="OnKeypadDigitClick" Content="." Style="{StaticResource KeypadButton}" Tag="PriceBox" />
                    </Grid>

                    <StackPanel
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding HidePriceOverrideCommand}"
                            Content="Batal"
                            Style="{StaticResource DialogSecondaryButton}" />
                        <Button
                            Command="{Binding ApplyPriceOverrideCommand}"
                            Content="Terapkan"
                            Style="{StaticResource DialogPrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Void confirmation ===================== -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="57"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsVoidConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="400" Style="{StaticResource DialogShell}">
                <StackPanel Margin="20">
                    <TextBlock
                        Style="{StaticResource Text.DialogTitle}"
                        Foreground="{DynamicResource Brush.Danger}"
                        Text="Batalkan transaksi?" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="Semua item di keranjang akan dihapus. Lanjutkan?"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding CancelVoidConfirmCommand}"
                            Content="Tidak"
                            Style="{StaticResource DialogSecondaryButton}" />
                        <Button
                            Command="{Binding ConfirmVoidCommand}"
                            Content="Ya, batalkan"
                            Style="{StaticResource Button.Danger}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== Customer dialog ===================== -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="56"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsCustomerVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="560" Height="540" Style="{StaticResource DialogShell}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Style="{StaticResource Text.DialogTitle}" Text="Pelanggan" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{Binding HideCustomerCommand}"
                            Content="&#xE711;"
                            Style="{StaticResource DialogClose}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBox
                            Height="38"
                            Style="{StaticResource DialogField}"
                            Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            IsHitTestVisible="False"
                            Text="Cari nama atau kode pelanggan">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomerSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button
                        Grid.Row="2"
                        Margin="0,8,0,8"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearCustomerCommand}"
                        Style="{StaticResource Button.Ghost}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE77B;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="Pelanggan umum" />
                        </StackPanel>
                    </Button>

                    <Border
                        Grid.Row="3"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CustomerResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Padding="12,8"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.ApplyCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Ghost}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                    Text="&#xE77B;" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="{StaticResource Font.Weight.SemiBold}"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        Text="{Binding Code}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                    Text="{Binding PriceListName}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock
                        Grid.Row="4"
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding CustomerError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding CustomerError, Converter={StaticResource StringToVisibility}}" />
                </Grid>
            </Border>
        </Border>

        <!-- ===================== Advanced search (F3) ===================== -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="58"
            Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding IsSearchModalOpen, Converter={StaticResource BoolToVisibility}}">
            <Border
                Width="760"
                Height="520"
                Background="{DynamicResource Brush.Bg}"
                BorderBrush="{DynamicResource Brush.BorderInput}"
                BorderThickness="1">
                <ContentControl Content="{Binding ProductSearchVm}" />
            </Border>
        </Border>

        <!-- ===================== Payment screen ===================== -->
        <Border
            x:Name="PaymentOverlay"
            Grid.RowSpan="2"
            Panel.ZIndex="43"
            Background="{DynamicResource Brush.Bg}"
            IsVisibleChanged="OnPaymentOverlayVisibleChanged"
            Visibility="{Binding IsPaymentVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="8,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource PaymentTitle}"
                        Text="Aksi" />
                    <Button
                        HorizontalAlignment="Right"
                        Click="OnTogglePaymentKeypadClick"
                        Content="&#xE765;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="20"
                        Foreground="{DynamicResource Brush.Accent}"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="Tampilkan / sembunyikan papan angka" />
                </Grid>

                <!-- Action buttons -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding HidePaymentCommand}"
                        Style="{StaticResource PaymentActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Text="&#xE711;" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Batal" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding ShowDiscountCommand}"
                        Style="{StaticResource PaymentActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="{StaticResource Font.Weight.Light}"
                                Text="%" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Diskon" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding RoundPaymentCommand}"
                        Style="{StaticResource PaymentActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Text="&#xE8EF;" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Pembulatan" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding ShowCustomerCommand}"
                        Style="{StaticResource PaymentActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Text="&#xE77B;" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Pelanggan" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Body -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Payment types -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource PaymentTitle}" Text="Tipe pembayaran" />
                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding PaymentTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.ChoosePaymentTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PaymentTypeChoice}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource PaymentTypeChoice}" ToolTip="Pembayaran terpisah">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="15"
                                    Text="&#xE8C4;" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Pembayaran terpisah" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Payment details -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource PaymentTitle}" Text="Pembayaran" />

                        <!-- Total -->
                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="Total:" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource PaymentValue}"
                                Foreground="{DynamicResource Brush.Accent}"
                                Text="{Binding TotalText}" />
                        </Grid>

                        <!-- Paid -->
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="Dibayar:" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    Margin="22,0,0,0"
                                    Click="OnFocusPaymentAmountClick"
                                    Content="&#xE70F;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="15"
                                    Foreground="{DynamicResource Brush.Accent}"
                                    Style="{StaticResource Button.Ghost}"
                                    ToolTip="Ubah jumlah dibayar" />
                            </StackPanel>
                            <TextBox
                                x:Name="PaymentAmountBox"
                                Grid.Column="1"
                                Style="{StaticResource PaymentPaidInput}"
                                Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyPaymentCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>

                        <!-- Change -->
                        <Grid Grid.Row="3" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="Kembali:" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource PaymentValue}"
                                Foreground="{DynamicResource Brush.Success}"
                                Text="{Binding PaymentChangeLabel}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            Style="{StaticResource Text.Error}"
                            Text="{Binding PaymentError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding PaymentError, Converter={StaticResource StringToVisibility}}" />

                        <!-- Virtual keypad (hidden by default, like Aronium) -->
                        <Border
                            x:Name="PaymentKeypad"
                            Grid.Row="5"
                            Margin="0,14,0,0"
                            Padding="10"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                            <StackPanel Width="316">
                                <ItemsControl Margin="0,0,0,6" ItemsSource="{Binding QuickPayAmounts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Height="28"
                                                Margin="2"
                                                Command="{Binding DataContext.SetPaymentAmountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding StringFormat={}{0:N0}}"
                                                FontSize="11"
                                                Style="{StaticResource Button.Base}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Click="OnKeypadDigitClick" Content="1" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="0" Grid.Column="1" Click="OnKeypadDigitClick" Content="2" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="0" Grid.Column="2" Click="OnKeypadDigitClick" Content="3" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="1" Grid.Column="0" Click="OnKeypadDigitClick" Content="4" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="1" Grid.Column="1" Click="OnKeypadDigitClick" Content="5" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="1" Grid.Column="2" Click="OnKeypadDigitClick" Content="6" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="2" Grid.Column="0" Click="OnKeypadDigitClick" Content="7" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="2" Grid.Column="1" Click="OnKeypadDigitClick" Content="8" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="2" Grid.Column="2" Click="OnKeypadDigitClick" Content="9" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="3" Grid.Column="0" Click="OnKeypadDigitClick" Content="0" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="3" Grid.Column="1" Click="OnKeypadDigitClick" Content="&#x232B;" FontFamily="{StaticResource Font.Sans}" Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                    <Button Grid.Row="3" Grid.Column="2" Click="OnKeypadDigitClick" Content="." Style="{StaticResource KeypadButton}" Tag="PaymentAmountBox" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Confirm -->
                        <StackPanel
                            Grid.Row="6"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Width="204"
                                Height="42"
                                Command="{Binding ApplyPaymentCommand}"
                                Content="Bayar"
                                Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
