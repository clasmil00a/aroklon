<UserControl
    x:Class="Pos.App.Views.PosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Bg}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Command="{Binding GoBackCommand}"
                    Content="← Beranda"
                    Style="{StaticResource Button.Ghost}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="Penjualan" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Cari produk, tambahkan ke keranjang, lalu bayar tunai." />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.BodyStrong}"
                    Text="{Binding Totals.TotalMinor, StringFormat='Rp {0:N0}'}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: search + results -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.Caption}"
                        Text="Cari produk (nama, kode, atau barcode)" />
                    <TextBox
                        x:Name="SearchBox"
                        Style="{StaticResource Input}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="Ketik lalu tekan Enter, atau pilih hasil di bawah."
                        TextWrapping="Wrap" />

                    <Border Margin="0,12,0,0" Style="{StaticResource Card}" Background="{DynamicResource Brush.Bg}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{StaticResource Text.SectionTitle}"
                                Text="Hasil pencarian" />
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="150"
                                            MinHeight="72"
                                            Margin="0,0,8,8"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Tile}">
                                            <StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource Text.BodyStrong}"
                                                    Text="{Binding Name}"
                                                    TextWrapping="Wrap"
                                                    MaxHeight="40" />
                                                <TextBlock
                                                    Style="{StaticResource Text.Secondary}"
                                                    Text="{Binding PriceMinor, StringFormat='Rp {0:N0}'}" />
                                                <TextBlock
                                                    Style="{StaticResource Text.Caption}"
                                                    Text="{Binding UnitName}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource Text.Caption}"
                                Text="{Binding SearchResults.Count, StringFormat='{}{0} hasil'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: cart -->
            <Border Grid.Column="2" Style="{StaticResource Card.Raised}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource Text.SectionTitle}"
                        Text="Keranjang belanja" />
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="8"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.BorderInput}"
                                    BorderThickness="{StaticResource Border.Width}"
                                    CornerRadius="{StaticResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding UnitName}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Orientation="Horizontal">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="−"
                                                Style="{StaticResource Button.Ghost}" />
                                            <TextBlock
                                                Margin="6,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Text.Body}"
                                                Text="{Binding QtyMilli, StringFormat='{}{0:0.###}'}" />
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="+"
                                                Style="{StaticResource Button.Ghost}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.BodyStrong}"
                                            Text="{Binding TotalMinor, StringFormat='Rp {0:N0}'}" />

                                        <Button
                                            Grid.Column="3"
                                            Width="28"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="×"
                                            Style="{StaticResource Button.Ghost}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Caption}"
                        Text="{Binding Lines.Count, StringFormat='{}{0} baris'}" />

                    <Border
                        Height="1"
                        Margin="0,12"
                        Background="{DynamicResource Brush.Border}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="Subtotal" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="Total" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Totals.SubtotalMinor, StringFormat='Rp {0:N0}'}" />
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Totals.TotalMinor, StringFormat='Rp {0:N0}'}" />
                        </StackPanel>
                    </Grid>

                    <Button
                        Margin="0,12,0,0"
                        Height="44"
                        Command="{Binding CheckoutCommand}"
                        Content="Bayar Tunai"
                        IsEnabled="{Binding CanCheckout}"
                        Style="{StaticResource Button.Primary}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Error}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
